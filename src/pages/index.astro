---
/**
 * Main Landing Page
 * Integrates all sections with preserved animations
 */
import GradientOverlay from "../components/GradientOverlay.astro";
import Separator from "../components/Separator.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../sections/Footer.astro";
import Header from "../sections/Header.astro";
import Hero from "../sections/Hero.astro";
import Process from "../sections/Process.astro";
import Services from "../sections/Services.astro";
import Stack from "../sections/Stack.astro";
import ContactForm from "../sections/ContactForm.astro";
---

<Layout class="overflow-hiden">
	<!-- Hero: Personaliza aquí -->
	<GradientOverlay position="top" size="medium" color="cyan" opacity="medium" blur="high">
		<Header />
		<Hero />
	</GradientOverlay>

	<Separator id="services-separator" />

	<!-- Services: Personaliza aquí -->
	<GradientOverlay position="center" size="medium" color="fuchsia" opacity="medium" blur="high">
		<Services />
	</GradientOverlay>

	<Separator id="process-separator" />

	<!-- Process: Personaliza aquí -->
	<GradientOverlay position="center" size="medium" color="cyan" opacity="medium" blur="high">
		<Process />
	</GradientOverlay>

	<Separator id="stack-separator" />

	<!-- Stack: Personaliza aquí -->
	<GradientOverlay position="center" size="medium" color="fuchsia" opacity="low" blur="high">
		<Stack />
	</GradientOverlay>

	<Separator id="contact-separator" />

	<!-- Contact: Personaliza aquí -->
	<GradientOverlay position="center" size="small" color="cyan" opacity="medium" blur="high">
		<ContactForm />
	</GradientOverlay>

	<!-- Footer: Personaliza aquí -->
	<GradientOverlay position="bottom" size="small" color="fuchsia" opacity="medium" blur="high">
		<Footer />
	</GradientOverlay>
</Layout>
