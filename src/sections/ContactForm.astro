---
import GradientText from "../components/GradientText.astro";
import FormInput from "../components/FormInput.astro";
import Button from "../components/Button.astro";
---

<section id="contact" class="w-full mb-50 max-w-7xl mx-auto lg:px-4 ">
    <div
      class="grid grid-cols-1 items-center lg:items-baseline lg:grid-cols-[60%_40%] gap-12 lg:gap-4"
    >
      <!-- Left Column: Contact Info -->
      <div class="contact-info flex flex-col gap-6 items-center lg:items-start text-center lg:text-left">
        <h2
          class="contact-title text-4xl sm:text-5xl lg:text-[64px] font-medium text-center lg:text-left mb-4 leading-tight"
        >
          ¿Hablamos de tu próxima <GradientText as="span" gradient="cyan-purple"
            >idea digital</GradientText>?
        </h2>

        
          

        <p
          class="contact-paragraph text-gray-300 text-base max-w-[500px] text-balance"
        >
          Cuéntanos qué necesitas y te ayudaremos a transformar tu idea en una
          solución digital real.
        </p>

        <p
          class="contact-paragraph text-gray-300 text-base max-w-[500px] text-balance"
        >
          Nos encanta colaborar con marcas y negocios que buscan crecer a través
          del diseño y la tecnología.
        </p>

        <div
          class="contact-logo my-6 max-w-[280px] sm:max-w-[360px] md:max-w-[360px] object-contain"
        >
          <img
            src="/codezone-logo-color.svg"
            alt="Logo de CodeZone"
            width="360"
            height="52"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div
          class="contact-buttons flex flex-wrap gap-3 justify-center items-center mt-2"
        >
          <Button
            href="tel:+34691019753"
            variant="outline"
            size="small"
            icon="phone-icon.svg"
            className="flex flex-row-reverse gap-2 whitespace-nowrap"
          >
            +34 691 019 753
          </Button>

          <Button
            href="mailto:info@codezone.com"
            variant="outline"
            size="small"
            icon="email-icon.svg"
            className="flex flex-row-reverse gap-2 whitespace-nowrap"
          >
            info@codezone.com
          </Button>
        </div>
      </div>

      <!-- Right Column: Form -->
      <div class="form-info w-full lg:max-w-[504px] mx-0">
        <div
          class="form-contact bg-[linear-gradient(180deg,#0e1738_0.38%,rgba(18,29,70,0)_100%)] border rounded-2xl p-4 sm:p-6 md:p-8"
        >
          <h3
            class="text-cyan-400 text-center font-semibold tracking-wide mb-6"
          >
            FORMULARIO DE CONTACTO
          </h3>

          <form
            id="contact-form"
            class="flex flex-col gap-4"
            autocomplete="off"
            novalidate
          >
            <div>
              <FormInput
                type="text"
                name="nombre"
                label="Nombre:"
                placeholder="Tu nombre y apellidos"
                required={true}
              />
              <span
                id="error-nombre"
                class="text-red-400 text-sm mt-1 block"
                aria-live="polite"></span>
            </div>

            <div>
              <FormInput
                type="email"
                name="email"
                label="Email:"
                placeholder="ejemplo: tu.nombre@example.com"
                required={true}
              />
              <span
                id="error-email"
                class="text-red-400 text-sm mt-1 block"
                aria-live="polite"></span>
            </div>

            <div>
              <FormInput
                type="tel"
                name="telefono"
                label="Teléfono:"
                placeholder="Ejemplo: +34681019753"
                required={true}
              />
              <span
                id="error-telefono"
                class="text-red-400 text-sm mt-1 block"
                aria-live="polite"></span>
            </div>

            <div>
              <FormInput
                type="textarea"
                name="mensaje"
                label="Mensaje:"
                placeholder="Déjanos un mensaje"
                required={false}
              />
              <span
                id="error-mensaje"
                class="text-red-400 text-sm mt-1 block"
                aria-live="polite"></span>
            </div>

            <div
              id="form-message"
              class="hidden"
              role="alert"
              aria-live="polite"
            >
            </div>

            <Button
              type="submit"
              variant="solid"
              size="large"
              icon="icon-arrow.svg"
              className="w-full mt-4"
            >
              Enviar
            </Button>
          </form>
        </div>
      </div>
    </div>
</section>

<style>
  .form-contact {
    background: transparent;
    background-image: linear-gradient(
        180deg,
        var(--primary-blue) 0%,
        var(--primary-blue) 50%
      ),
      linear-gradient(90deg, #c800de 0%, #53eafd 100%);
    background-clip: padding-box, border-box;
    background-origin: border-box;
    background-position: center left;
    background-size: 200% 200%;
    border: 2px solid transparent;
    transition: all 600ms ease;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
import { animateContactSection } from "../utils/animations/contact-animations";

  gsap.registerPlugin(ScrollTrigger);

  // Inicializar cuando el DOM esté listo
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", animateContactSection);
  } else {
    animateContactSection();
  }
</script>
