---
import Button from "../components/Button.astro";
import { mainNavigation } from "../data/navigation";
import MobileMenu from "../components/MobileMenu.astro";
---

<header
  class="fixed top-0 px-2 left-0 right-0 z-50 backdrop-blur-sm"
  style="--header-height:72px"
>
  <div
    class="container max-w-[1528px] h-14 md:h-18 mx-auto mt-4 px-4 flex justify-between items-center shadow-lg rounded-full glass-gradient-border backdrop-blur-md bg-transparent xl:p-4"
  >
    <a class="brand" href="#hero">
      <img
        src="/codezone-logo-color.svg"
        alt="Logo CodeZone"
        width="180px"
        height="26px"
        loading="eager"
      />
    </a>

    
    <nav
      class="topnav desktop-nav text-neutral-50 text-lg font-medium"
      aria-label="Main navigation"
      data-animate="header-nav"
    >
        <ul class="flex gap-6 blur-menu">
          {
            mainNavigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class={`nav-link hover:text-cyan-300 backdrop-blur-none px-2 py-1 rounded-md ${
                    item.isActive ? "text-cyan-300" : ""
                  }`}
                  aria-current={item.isActive ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
    </nav>

    <div class="desktop-cta">
      <Button
        href="#contact-separator"
        variant="outline"
        size="small"
        icon="icon-arrow.svg">Contacto</Button
      >
    </div>
    
    <MobileMenu navItems={mainNavigation} />
  </div>
</header>

<script>
  function initNavActiveLinks() {
    try {
      const links = Array.from(
        document.querySelectorAll('a[href^="#"].nav-link, #mobilemenu-items a'),
      );

      if (!links.length) return;

      // Flag para deshabilitar observer durante scroll programático
      let isProgrammaticScroll = false;

      // Map href -> link element (may be multiple: desktop + mobile)
      const linkMap = new Map();
      links.forEach((link) => {
        const href = link.getAttribute("href");
        if (!href) return;
        if (!linkMap.has(href)) linkMap.set(href, []);
        linkMap.get(href).push(link);

        // click handler: smooth scroll and set active
        link.addEventListener("click", (e) => {
          if (href.startsWith("#")) {
            e.preventDefault();
            const id = href.slice(1);
            const target = document.getElementById(id);
            if (target) {
              // Deshabilitar observer durante scroll programático
              isProgrammaticScroll = true;
              
              console.log('Click detected, scrolling to:', id);
              
              // Usar ScrollSmoother si está disponible, sino scrollIntoView
              const smoother = (window as any).smoother;
              if (smoother) {
                console.log('Using ScrollSmoother');
                try {
                  smoother.scrollTo(target, true, "top top");
                } catch (err) {
                  console.warn('ScrollSmoother error, using fallback:', err);
                  target.scrollIntoView({ behavior: "smooth", block: "start" });
                }
              } else {
                console.log('ScrollSmoother not available, using scrollIntoView');
                target.scrollIntoView({ behavior: "smooth", block: "start" });
              }
              
              // Re-habilitar observer después del scroll (2 segundos para scroll suave)
              setTimeout(() => {
                isProgrammaticScroll = false;
                console.log('Observer re-enabled');
              }, 2000);
              
              // Disparar evento personalizado para activar animaciones de la sección
              setTimeout(() => {
                const event = new CustomEvent('trigger-section-animations', {
                  detail: { sectionId: id }
                });
                document.dispatchEvent(event);
              }, 500);
            }
            if (href === "#contact-separator") {
              setActiveByHref(null);
            } else {
              setActiveByHref(href);
            }
            // ensure no hash remains in the URL after navigation
            removeHashFromUrl();
          }
        });
      });

      function removeHashFromUrl() {
        if (window.location.hash) {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }

      // @ts-ignore: allow dynamic typing for DOM helper
      function setActiveByHref(href) {
        // remove from all
        for (const l of links) {
          /** @type {HTMLElement} */ (l).removeAttribute("aria-current");
        }
        if (!href) return; // clear active when no href provided
        const same = linkMap.get(href) || [];
        for (const l of same) {
          /** @type {HTMLElement} */ (l).setAttribute("aria-current", "page");
        }
      }

      const observerOptions = {
        root: null,
        rootMargin: "0px 0px -60% 0px",
        threshold: 0,
      };
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          // Ignorar cambios durante scroll programático
          if (isProgrammaticScroll) return;
          
          if (entry.isIntersecting) {
            const id = entry.target.id;
            if (!id) return;
            // Do not mark the contact section as active
            if (id === "contact-separator") return;
            const href = `#${id}`;
            setActiveByHref(href);
          }
        });
      }, observerOptions);

      linkMap.forEach((_v, href) => {
        if (!href || !href.startsWith("#")) return;
        const id = href.slice(1);
        const target = document.getElementById(id);
        if (target) observer.observe(target);
      });

      // @ts-ignore
      window.setActiveNavHref = setActiveByHref;

      window.addEventListener('codezone:setActiveNavHref', (ev) => {
        // @ts-ignore: event detail typing
        setActiveByHref(ev.detail);
      });

      const brandAnchor = document.querySelector('a.brand[href="#hero"]');
      if (brandAnchor) {
        brandAnchor.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.getElementById('hero');
          if (target) {
            // Usar ScrollSmoother si está disponible, sino scrollIntoView
            const smoother = (window as any).smoother;
            if (smoother) {
              smoother.scrollTo(target, true, "top");
            } else {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
          setActiveByHref(null);

          removeHashFromUrl();
        });
      }

      document.addEventListener("click", (e) => {
        const maybeElement = e.target;
        const anchor =
          maybeElement instanceof Element
            ? maybeElement.closest('a[href="#contact-separator"]')
            : null;
        if (anchor) {
          setTimeout(() => setActiveByHref(null), 0);
        }
        removeHashFromUrl();
      });

      window.addEventListener('hashchange', () => {
        const h = window.location.hash || '';
        if (!h) return;
        const id = h.slice(1);
        if (!id) {
          history.replaceState(null, '', window.location.pathname + window.location.search);
          return;
        }
        const target = document.getElementById(id);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          if (h !== '#contact-separator') {
            setActiveByHref(h);
          }
        }
        history.replaceState(null, '', window.location.pathname + window.location.search);
      });

      window.addEventListener('popstate', () => {
        if (window.location.hash) {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      });
    } catch (err) {
      /* ignore errors in nav initialization */
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNavActiveLinks);
  } else {
    initNavActiveLinks();
  }
 
</script>

<style>
  .glass-gradient-border {
    position: relative;
    z-index: 0;
  }

  .glass-gradient-border::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    padding: 2px;
    border-radius: 9999px;
    background: linear-gradient(45deg, var(--fuchsia-600), var(--cyan-300));
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .desktop-nav,
  .desktop-cta {
    display: none;
  }

  .brand img {
    width: 140px;
    height: auto;
  }

  .nav-link[aria-current="page"] {
    color: #53eafd;
  }

  .desktop-nav a,
  .desktop-cta .btn {
    font-size: 18px;
    transition: all 400ms ease-in-out;
  }

  .nav-link {
    filter: blur(0);
    transition: all 400ms ease-in-out, filter 400ms ease-in-out, opacity 400ms ease-in-out;
  }

  .blur-menu:has(.nav-link:hover) .nav-link:not(:hover) {
    opacity: 0.6;
    filter: blur(1.2px);
  }

  .nav-link:hover {
    color: #53eafd;
    filter: blur(0);
  }

  @media (min-width: 1024px) {
    .desktop-nav,
    .desktop-cta {
      display: block;
    }

    .brand img {
      width: 180px;
      height: auto;
    }
  }
</style>
