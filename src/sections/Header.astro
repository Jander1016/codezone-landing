---
import Button from "../components/Button.astro";
import MobileMenu from "../components/MobileMenu.astro";
import { mainNavigation } from "../data/navigation";
---

<header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-sm">
  <div class="container max-w-[1528px] mx-auto mt-6 px-4 bg-primary-blue/90 rounded-full flex justify-between items-center p-2 shadow-lg linear-gradient-primary">
    <a class="brand" href="/">
      <img
        src="/codezone-logo-color.svg"
        alt="Logo CodeZone"
        width="180"
        height="26"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav text-neutral-50 text-lg font-medium" aria-label="Main navigation">
      <ul class="flex gap-6">
        {mainNavigation.map((item) => (
          <li>
            <a 
              href={item.href} 
              class="hover:text-cyan-300 transition-colors"
              aria-current={item.isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Desktop CTA Button -->
    <div class="desktop-cta">
      <Button href="#contact" variant="outline" size="small" icon="icon-arrow.svg">Contacto</Button>
    </div>

    <!-- Mobile Menu Toggle -->
    <button
      id="mobile-menu-toggle"
      class="mobile-menu-toggle"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      type="button"
      onclick="window.openMobileMenu?.()"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    </div>
</header>

<!-- Mobile Menu Component -->
<MobileMenu navItems={mainNavigation} />

<style>
  .linear-gradient-primary {
    background-image: linear-gradient(180deg, rgba(2, 6, 24, 1) 0%, rgba(18, 29, 70, 1) 50%),
      linear-gradient(45deg, var(--fuchsia-600), var(--cyan-300));
    background-clip: padding-box, border-box;
    background-origin: border-box;
    border: 2px solid transparent;
  }

  /* Mobile-first defaults: show mobile toggle, hide desktop nav/cta */
  .mobile-menu-toggle {
    display: block;
    background: transparent;
    border: none;
    color: #53eafd;
    cursor: pointer;
    padding: 0.5rem;
    transition: color 300ms ease;
  }

  .mobile-menu-toggle:hover {
    color: #c800de;
  }

  .desktop-nav,
  .desktop-cta {
    display: none;
  }

  .brand img {
    width: 140px;
    height: auto;
  }

  /* Desktop and up: show desktop navigation and CTA, hide mobile toggle */
  @media (min-width: 768px) {
    .desktop-nav,
    .desktop-cta {
      display: block;
    }

    .mobile-menu-toggle {
      display: none;
    }

    .brand img {
      width: 180px;
      height: auto;
    }
  }
</style>
