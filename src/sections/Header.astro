<style>
  .glass-gradient-border {
    position: relative;
    z-index: 0;
  }

  .glass-gradient-border::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    padding: 2px;
    border-radius: 9999px;
    background: linear-gradient(45deg, var(--fuchsia-600), var(--cyan-300));
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* Mobile-first approach: hide desktop navigation by default */
  .desktop-nav,
  .desktop-cta {
    display: none;
  }

  /* Logo - accessible with explicit dimensions */
  .brand {
    display: inline-block;
    line-height: 0;
  }

  .brand img {
    width: 140px;
    height: 26px;
    display: block;
  }

  /* Active navigation state */
  .nav-link[aria-current="page"] {
    color: var(--cyan-300);
  }

  /* Desktop navigation and CTA styles */
  .desktop-nav a,
  .desktop-cta .btn {
    font-size: 18px;
    transition: all var(--transition-base);
  }

  /* Navigation link with smooth transitions */
  .nav-link {
    filter: blur(0);
    transition: 
      all var(--transition-base),
      filter var(--transition-base),
      opacity var(--transition-base);
  }

  /* Blur effect on non-hovered items when any item is hovered */
  .blur-menu:has(.nav-link:hover) .nav-link:not(:hover) {
    opacity: 0.6;
    filter: blur(1.2px);
  }

  /* Hover state */
  .nav-link:hover {
    color: var(--cyan-300);
    filter: blur(0);
  }

  /* Focus state for keyboard navigation */
  .nav-link:focus-visible {
    outline: 2px solid var(--cyan-300);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* Desktop breakpoint (1024px and up) - full desktop layout */
  @media (min-width: 1024px) {
    .desktop-nav,
    .desktop-cta {
      display: block;
    }
    
    .brand img {
      width: 180px;
      height: auto;
    }
  }
</style>
