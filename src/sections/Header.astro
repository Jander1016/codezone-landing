---
import Button from "../components/Button.astro";
import { mainNavigation, mainNavigationMobile } from "../data/navigation";
import MobileMenu from "../components/MobileMenu.astro";
---

<header
  class="fixed top-0 px-2 left-0 right-0 z-(--z-header) backdrop-blur-sm"
  style="--header-height:72px"
>
  <div
    class="container max-w-(--width-max-content) h-14 md:h-18 mx-auto mt-4 px-4 flex justify-between items-center shadow-lg rounded-full glass-gradient-border backdrop-blur-md bg-transparent xl:p-4"
  >
    <a class="brand" href="#hero">
      <img
        src="/codezone-logo-color.svg"
        alt="Logo de CodeZone - Ir a inicio"
        width="180"
        height="26"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav
      class="topnav desktop-nav text-neutral-50 text-lg font-medium"
      aria-label="Main navigation"
      data-animate="header-nav"
    >
      <ul class="flex gap-6 blur-menu">
        {
          mainNavigation.map((item) => {
            // Extract section ID from href (e.g., "#services-separator" -> "services-separator")
            const sectionId = item.href.startsWith("#")
              ? item.href.slice(1)
              : item.href;

            return (
              <li>
                <a
                  href={item.href}
                  data-nav-link
                  data-section={sectionId}
                  class={`nav-link hover:text-cyan-300 backdrop-blur-none px-2 py-1 rounded-md ${
                    item.isActive ? "text-cyan-300" : ""
                  }`}
                  aria-current={item.isActive ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="desktop-cta">
      <Button
        href="#contact-separator"
        variant="outline"
        size="small"
        icon="icon-arrow.svg"
        >Contacto</Button
      >
    </div>

    <MobileMenu navItems={mainNavigationMobile} />
  </div>
</header>

<script>
  import {
    initialize,
    handleNavigationClick,
    NAV_CONFIG,
  } from "../utils/navigation/navigation-manager";

  document.addEventListener("DOMContentLoaded", () => {
    // Get all desktop nav links
    const desktopLinks = Array.from(
      document.querySelectorAll('.desktop-nav a[href^="#"]'),
    ) as HTMLElement[];

    // Get all mobile nav links
    const mobileLinks = Array.from(
      document.querySelectorAll(".mobilemenu-item"),
    ) as HTMLElement[];

    // Combine all navigation links for initialization
    const allNavLinks = [...desktopLinks, ...mobileLinks];

    // Initialize NavigationManager with all links
    initialize(allNavLinks);

    // Attach click handlers to desktop nav links
    desktopLinks.forEach((link) => {
      const href = link.getAttribute("href");
      if (!href) return;

      link.addEventListener("click", (e) => {
        handleNavigationClick(e, href);
      });
    });

    // Handle logo click
    const logo = document.querySelector('a.brand[href="#hero"]');
    if (logo) {
      logo.addEventListener("click", (e) => {
        handleNavigationClick(e, "#hero");
      });
    }

    // Handle CTA button
    const ctaButton = document.querySelector('a[href="#contact-separator"]');
    if (ctaButton) {
      ctaButton.addEventListener("click", (e) => {
        handleNavigationClick(e, "#contact-separator");
      });
    }

    // Listen for active state sync events
    window.addEventListener("codezone:setActiveNavHref", (event) => {
      const activeHref = (event as CustomEvent).detail;

      // Update visual state of desktop links
      desktopLinks.forEach((link) => {
        const href = link.getAttribute("href");
        if (href === activeHref) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    });
  });
</script>

<style>
  .glass-gradient-border {
    position: relative;
    z-index: 0;
  }

  .glass-gradient-border::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    padding: 2px;
    border-radius: 9999px;
    background: linear-gradient(360deg, var(--fuchsia-600), var(--cyan-300));
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* Mobile-first approach: hide desktop navigation by default */
  .desktop-nav,
  .desktop-cta {
    display: none;
  }

  /* Logo - accessible with explicit dimensions */
  .brand {
    display: inline-block;
    line-height: 0;
  }

  .brand img {
    width: 140px;
    height: 26px;
    display: block;
  }

  /* Active navigation state */
  .nav-link[aria-current="page"] {
    color: var(--cyan-300);
  }

  /* Desktop navigation and CTA styles */
  .desktop-nav a,
  .desktop-cta .btn {
    font-size: 18px;
    transition: all var(--transition-base);
  }

  /* Navigation link with smooth transitions */
  .nav-link {
    filter: blur(0);
    transition:
      all var(--transition-base),
      filter var(--transition-base),
      opacity var(--transition-base);
  }

  /* Blur effect on non-hovered items when any item is hovered */
  .blur-menu:has(.nav-link:hover) .nav-link:not(:hover) {
    opacity: 0.6;
    filter: blur(1.2px);
  }

  /* Hover state */
  .nav-link:hover {
    color: var(--cyan-300);
    filter: blur(0);
  }

  /* Focus state for keyboard navigation */
  .nav-link:focus-visible {
    outline: 2px solid var(--cyan-300);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* Desktop breakpoint (1024px and up) - full desktop layout */
  @media (min-width: 1024px) {
    .desktop-nav,
    .desktop-cta {
      display: block;
    }

    .brand img {
      width: 180px;
      height: auto;
    }
  }
</style>
