---
import Button from "../components/Button.astro";
---

<header class="max-w-[1356px] mx-auto p-4">
  <div class="bg-primary-blue rounded-full flex justify-between items-center p-2 shadow-lg linear-gradient-primary">
    <a class="brand" href="/">
      <img
        src="/codezone-logo-color.svg"
        alt="Logo CodeZone"
        width="180"
        height="26"
      />
    </a>

    <nav class="font-onest text-neutral-50 text-lg font-bold">
      <ul class="flex gap-6">
        <li><a href="#" class="hover:text-cyan-300 transition-colors">Tecnología a medida</a></li>
        <li><a href="#" class="hover:text-cyan-300 transition-colors">Cómo lo hacemos</a></li>
        <li><a href="#" class="hover:text-cyan-300 transition-colors">Nuestro stack tecnológico</a></li>
      </ul>
    </nav>

    <Button href="#contact" variant="outline" size="small">Contacto &gt;</Button>
  </div>
</header>

<style>
  .linear-gradient-primary {
    background-image: linear-gradient(180deg, rgba(2, 6, 24, 1) 0%, rgba(18, 29, 70, 1) 50%),
      linear-gradient(45deg, var(--fuchsia-600), var(--cyan-300));
    background-clip: padding-box, border-box;
    background-origin: border-box;
    border: 2px solid transparent;
  }
</style>
