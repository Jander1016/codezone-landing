---
import Button from "../components/Button.astro";
---

<main>
  <section id="hero" class="flex items-center justify-center pt-20 sm:pt-24 md:pt-28 pb-8 ">
      <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-6 md:gap-8 md:py-16 w-full max-w-[1528px] mx-auto" style="min-height: calc(100vh - var(--header-height));">
      <div class="flex-1 text-center md:text-left md:pr-6">
        <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-6xl xl:text-7xl font-medium  leading-tight py-4 max-w-2xl mx-auto md:mx-0">
          Hacemos realidad tu idea digital
        </h2>
        <p class="text-sm sm:text-base md:text-[18px] lg:text-xl xl:text-2xl font-medium text-cyan-300 py-4 max-w-lg mx-auto md:mx-0">
          Desarrollo de páginas web, software a medida e integración de sistemas
          (APIs)
        </p>
        <div class="py-6">
          <Button href="#contact" variant="solid" size="large">Hablemos de tu proyecto</Button>
        </div>
      </div>

      <div class="flex-1 flex justify-center items-center w-full lg:justify-end">
        <div class="relative overflow-hidden w-5/6 md:w-full max-w-[520px] aspect-square flex justify-center items-center">
          <img
            class="absolute inset-0  object-contain animate-spin-slow"
            src="/neon-circles.svg"
            alt="Anillos neon"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <img
            class="relative z-10 w-1/2 md:w-1/2 max-w-3xs h-auto animate-logo-pulse"
            src="/codezone-logo-header.svg"
            alt="Logo CodeZone 2"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>
</main>

<style>
  @keyframes spin-slow {
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 6s linear infinite;
  }

  @keyframes logo-pulse {
    0%,
    100% {
      filter: drop-shadow(0 0 5px rgba(200, 0, 222, 0.5));
    }
    70% {
      filter: drop-shadow(0 0 25px rgba(83, 233, 253, 0.5));
    }
  }

  .animate-logo-pulse {
    animation: logo-pulse 6s infinite linear;
  }

  .animate-logo-pulse:hover {
    transform: rotate(360deg);
  }
</style>
