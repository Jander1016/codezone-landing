---
import Button from "../components/Button.astro";
---

<main>
  <section
    id="hero"
    class="flex items-center justify-center pt-20 sm:pt-24 md:pt-28 pb-8"
  >
    <div
      class="flex flex-col-reverse md:flex-row items-center justify-between gap-6 md:py-16 w-full max-w-[1528px] mx-auto"
      style="min-height: calc(100vh - var(--header-height));"
    >
      <article class="flex-1 text-center md:text-left md:pr-6">
        <h2
          class="hero-title text-4xl md:text-5xl lg:text-6xl xl:text-[90px] font-medium"
        >
          <span class="hero-title-first block">Hacemos realidad</span>
          <span class="hero-title-second">tu idea digital</span>
        </h2>
        <h1
          class="hero-subtitle text-lg font-medium text-cyan-300 py-4 mx-auto md:mx-0 md:text-2xl lg:text-3xl xl:text-[40px]"
        >
          Desarrollo de páginas web, software a medida e integración de sistemas
          (APIs)
        </h1>
        <div class="py-6">
          <Button href="#contact-separator" variant="solid" size="large"
            >Hablemos de tu proyecto</Button
          >
        </div>
      </article>
      <article class="right-content">
        <div class="animation-circles-container">
          <div class="capa-stack">
            <img
              class="logo-glow-fx animate-logo-pulse"
              src="codezone-logo-header.svg"
              alt="Imagen del logo de iniciales Codezone"
              fetchpriority="high"
              loading="eager"
            />
          </div>
          <div class="capa-stack">
            <img
              class="neon-circle-img"
              src="neon-circles.svg"
              alt="Imagen de círculos de neón"
              fetchpriority="high"
              loading="eager"
            />
          </div>
        </div>
      </article>
    </div>
  </section>
</main>

<style>
  @keyframes spin-slow {
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 6s linear infinite;
  }
 
  @keyframes animate-logo-pulse {
    0%,100% {
      filter: drop-shadow(0 0 10px rgba(200, 0, 222, 0.75));
    }

    50% {
      filter: drop-shadow(0 0 25px rgba(83, 233, 253, 0.75));
    }
  }

  .animate-logo-pulse {
    animation: logo-pulse 6s infinite linear;
  }

  .animate-logo-pulse:hover {
    transform: rotate(360deg);
  }

  .animation-circles-container {
    display: grid;
    grid-template-areas: "stack";
  }

  .capa-stack {
    grid-area: stack;
    justify-self: center;
    align-self: center;
    place-items: center;
    overflow: hidden;
  }

  .neon-circle-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    animation: rotate-animation 6s infinite linear;
  }

  @keyframes rotate-animation {
    to {
      transform: rotate(360deg);
    }
  }
   
  .logo-glow-fx {
    transition: transform 0.8s ease-out;
    transform: rotateY(0deg);
    animation: animate-logo-pulse 6s infinite linear;
  }

  .header-container {
    width: 100%;
    max-width: 1528px;
    min-height: 100vh;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .left-content {
    width: 60%;
  }
  .right-content {
    flex: 0 0 40%;
    width: 40%;
    margin-left: auto; /* push to the right */
  }

  #hero {
    width: 888;
    height: 362;
    top: 275px;
    left: 192px;
    opacity: 1;
    gap: 32px;
  }

  @media (width <= 1024px) {
    .header-container {
      flex-direction: column-reverse;
      padding: 8px;
    }

    .left-content {
      width: 100%;
    }
    .right-content {
      flex: 1;
      width: 100%;
    }
  }

  @media (width <= 768px) {
    .logo-glow-fx {
      width: 140px;
      height: auto;
    }
  }

  /* .hero-title {
    keep same mobile minimum (36px) but scale more aggressively on wide screens
    font-size: clamp(36px, 8.5vw, 80px);
    line-height: 0.95;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
    hyphens: auto;
    word-break: break-word;
    max-width: 100%;
    text-wrap: balance;
  } */

  /* Force the span to the second line so the heading is exactly two lines
     matching the reference layout. This is reliable and CSS-only. */
  /* .hero-title > .hero-title-first {
    display: block;
    white-space: nowrap; 
    overflow: visible;
  } */

  /* .hero-title > .hero-title-second {
    display: block;
    margin-top: 0.05em;
  } */

  /* Slightly larger subtitle to match the design proportion */
  .hero-subtitle {
    /* font-size: clamp(18px, 2.4vw, 40px);
    margin-top: 0.75rem; */
  }
</style>
