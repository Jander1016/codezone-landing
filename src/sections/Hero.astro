---
import Button from "../components/Button.astro";
---

<section
  id="hero"
  class="flex items-center justify-center pt-24 md:pt-24 lg:pt-20 overflow-hidden"
>
  <div
    class="flex flex-col-reverse md:flex-row items-center justify-between gap-4 md:pt-16 w-full max-w-(--width-max-content) mx-auto"
  >
    <article class="flex-1 text-center md:text-left md:pr-6">
      <h2
        class="hero-title text-4xl md:text-5xl lg:text-6xl xl:text-[90px] font-medium"
        data-animate="hero-title"
      >
        <span class="hero-title-first block">Hacemos realidad</span>
        <span class="hero-title-second">tu idea digital</span>
      </h2>
      <h1
        class="hero-subtitle text-lg font-medium text-cyan-300 py-4 mx-auto md:mx-0 md:text-2xl lg:text-3xl xl:text-[40px]"
        data-animate="hero-subtitle"
      >
        Desarrollo de páginas web, software a medida e integración de sistemas
        (APIs)
      </h1>
      <div class="hero-cta py-6" data-animate="hero-cta">
        <Button href="#contact-separator" variant="solid" size="large"
          >Hablemos de tu proyecto</Button
        >
      </div>
    </article>
    <article class="right-content">
      <div
        class="animation-circles-container py-4 md:py-2"
        data-animate="hero-image"
      >
        <div class="capa-stack">
          <div class="logo-container">
            <div class="logo-glow-bg"></div>
            <img
              class="logo-image"
              src="/codezone-logo-header.svg"
              alt="Logo de CodeZone con iniciales C y Z"
              fetchpriority="high"
              loading="eager"
            />
          </div>
        </div>
        <div class="capa-stack">
          <img
            class="neon-circle-img"
            width="600"
            height="600"
            src="/neon-circles.svg"
            alt="Círculos de neón decorativos animados"
            fetchpriority="high"
            loading="eager"
          />
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  @keyframes spin-slow {
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 6s linear infinite;
  }

  /* Optimized Glow Animation using opacity/transform instead of filter */
  @keyframes pulse-glow {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(0.8);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  .logo-container {
    position: relative;
    display: grid;
    place-items: center;
  }

  /* Background glow layer */
  .logo-glow-bg {
    position: absolute;
    inset: -20%;
    background: radial-gradient(
      circle,
      rgba(83, 233, 253, 0.4) 0%,
      rgba(200, 0, 222, 0.1) 70%,
      transparent 100%
    );
    filter: blur(20px);
    z-index: 0;
    border-radius: 50%;
    animation: pulse-glow 3s ease-in-out infinite;
    pointer-events: none;
    will-change: opacity, transform;
  }

  .animation-circles-container {
    display: grid;
    grid-template-areas: "stack";
    overflow: hidden;
  }

  .capa-stack {
    grid-area: stack;
    justify-self: center;
    align-self: center;
    place-items: center;
  }

  .neon-circle-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    animation: rotate-animation 6s infinite linear;
    will-change: transform;
  }

  @keyframes rotate-animation {
    to {
      transform: rotate(360deg);
    }
  }

  .logo-image {
    position: relative;
    z-index: 1;
    transition: transform 0.8s ease-out;
    transform: rotateY(0deg);
    /* Static drop-shadow is less expensive than animated */
    filter: drop-shadow(0 0 15px rgba(83, 233, 253, 0.3));
  }

  .logo-image:hover {
    transform: rotate(360deg);
  }

  .header-container {
    width: 100%;
    max-width: var(--width-max-content);
    min-height: 100dvh;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .left-content {
    width: 60%;
  }
  .right-content {
    flex: 0 0 40%;
    width: 40%;
    margin-left: auto;
  }

  #hero {
    /* width: 888; */
    /* height: 362; */
    /* min-height: 100dvh; */
    /* top: 275px;
    left: 192px;
    opacity: 1;
    gap: 32px; */
  }

  @media (width <= 1024px) {
    .header-container {
      flex-direction: column-reverse;
      padding: 8px;
    }

    .left-content {
      width: 100%;
    }
    .right-content {
      flex: 1;
      width: 100%;
    }
    .logo-glow-fx {
      width: 180px;
      height: auto;
    }
  }

  @media (width <= 768px) {
    .logo-glow-fx {
      width: 150px;
      height: auto;
    }
  }
</style>

