---
import Button from "../components/Button.astro";
import Services from "./Services.astro";
---
<main class="relative">
  <section id="hero" class="relative min-h-screen flex items-center justify-center">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center max-w-7xl mx-auto">
      <div class="text-left">
  <h2 class="text-6xl font-bold text-white py-4">Hacemos realidad tu idea digital</h2>
        <p class="font-onest text-3xl font-medium text-cyan-300 py-4">
          Desarrollo de páginas web, software a medida e integración de sistemas
          (APIs)
        </p>
        <div class="py-8">
          <Button href="#contact" variant="solid" size="large">Hablemos de tu proyecto</Button>
        </div>
      </div>

      <div class="flex justify-center items-center w-full">
        <div class="relative w-[320px] h-[320px] md:w-[520px] md:h-[520px] flex justify-center items-center">
          <img
            class="absolute inset-0 w-full h-full object-contain animate-spin-slow"
            src="/neon-circles.svg"
            alt="Anillos neon"
          />
          <img
            class="absolute inset-0 m-auto w-[120px] h-auto md:w-[180px] animate-logo-pulse"
            src="/codezone-logo-header.svg"
            alt="CodeZone"
          />
        </div>
      </div>
    </div>
  </section>
    <div class="w-full relative flex justify-center items-end pointer-events-none select-none">
      <img 
        src="/separador-desktop.svg" 
        alt="Separador decorativo" 
        class="w-full max-w-[1558px] h-[120px] md:h-[136px] object-cover object-bottom"
        style="min-width:600px;"
        loading="lazy" 
      />
    </div>
  <section class=" bottom-0 w-full flex justify-center pb-8">
    <Services />
  </section>
</main>

<style>
  @keyframes spin-slow {
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 12s linear infinite;
  }

  @keyframes logo-pulse {
    0%,
    100% {
      filter: drop-shadow(0 0 5px rgba(200, 0, 222, 0.75));
    }
    50% {
      filter: drop-shadow(0 0 25px rgba(83, 233, 253, 0.75));
    }
  }

  .animate-logo-pulse {
    animation: logo-pulse 6s infinite linear;
  }
</style>
