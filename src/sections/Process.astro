---
import ProcessCard from "../components/ProcessCard.astro";
import { processSteps } from "../data/process";
---

<section id="process" class="process-section py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-6">
    <p class="text-lg font-semibold text-center text-cyan-300 mb-2">
      Design Thinking + Scrum
    </p>
  
    <h2 class="text-4xl md:text-5xl font-medium text-center mb-12">
      ¿Cómo lo hacemos?
    </h2>


    <div class="process-steps space-y-28 mx-0 px-0">
      {processSteps.map((step, index) => (
        <ProcessCard
          number={step.number}
          title={step.title}
          description={step.description}
          image={step.image}
          isEven={index % 2 !== 0}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .process-section {
    width: 100%;
  }
</style>
