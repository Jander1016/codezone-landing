---
import ProcessCard from "../components/ProcessCard.astro";
import { processSteps } from "../data/process";
---

<section id="process" class="process-section">
  <div class="max-w-332 mx-auto px-1 lg:px-6">
    <h2 class="text-lg lg:text-2xl font-medium text-center text-cyan-400 mb-2">
      Design Thinking + Scrum
    </h2>

    <h2 class="text-4xl sm:text-5xl md:text-[64px] font-medium text-center mb-12 md:mb-14 lg:mb-16">
      ¿Cómo lo hacemos?
    </h2>


    <div class="flex flex-col process-steps space-y-20 md:space-y-24 lg:space-y-28 mx-0 px-0">
      {processSteps.map((step, index) => (
        <ProcessCard
          number={step.number}
          title={step.title}
          description={step.description}
          image={step.image}
          isEven={index % 2 !== 0}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .process-section {
    width: 100%;
  }
</style>
