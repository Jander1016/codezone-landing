---
import TechStackCard from "../components/TechStackCard.astro";
import { techStack } from "../data/techStack";
---

<section id="stack" class="stack-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="pb-10">
      <h2 class="stack-subtitle text-lg lg:text-2xl font-medium text-center text-cyan-400 mb-2">
        Herramientas
      </h2>
      <h2 class="stack-title text-4xl sm:text-5xl md:text-[64px] font-medium text-center mb-12 md:mb-14 lg:mb-16">
        Nuestro Stack Tecnológico
      </h2>
    </div>

    <div class="stack-grid grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 md:gap-10 lg:gap-x-12 lg:gap-y-12 w-full max-w-[1200px] mx-auto justify-items-center">
      {
        techStack.map((category, idx) => (
          <div class={`tech-stack-card ${idx >= techStack.length - 2 ? "lg:col-span-2 lg:justify-self-center w-full flex justify-center" : "w-full flex justify-center"}`}>
            <TechStackCard
              name={category.name}
              icon={category.icon}
              technologies={category.technologies}
              description={category.description}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { animateStackSection } from "../utils/animations/section-animations";

  gsap.registerPlugin(ScrollTrigger);

  function initStackAnimations() {
    // Animar toda la sección Stack usando la función centralizada
    animateStackSection();
    // Asegurar que el separador #stack-separator aparezca tras las animaciones
    // animateSeparatorAfterSection('#stack', '#stack-separator', { pollDelay: 150, timeout: 4000, finalDelay: 120 });
  }

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initStackAnimations);
  } else {
    initStackAnimations();
  }
</script>
