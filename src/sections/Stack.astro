---
/**
 * Stack Section - "Nuestro Stack Tenológico"
 * Displays technology categories with responsive grid
 * Mobile: 2 columns, Tablet: 3 columns, Desktop: 4 columns
 */
import GradientText from "../components/GradientText.astro";
import TechStackCard from "../components/TechStackCard.astro";
import { techStack } from "../data/techStack";
---

<section id="stack" class="stack-section py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-lg font-semibold text-center text-cyan-400 mb-2">Herramientas</p>
    <GradientText 
      as="h2" 
      gradient="cyan-purple"
      className="text-5xl font-extrabold text-center mb-16"
    >
      Nuestro Stack Tecnológico
    </GradientText>

    <div class="stack-grid">
      {techStack.map((category) => (
        <TechStackCard
          name={category.name}
          icon={category.icon}
          technologies={category.technologies}
          description={category.description}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .stack-section {
    width: 100%;
  }

  /* Mobile: 2 columns */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    justify-items: center;
  }

  /* Tablet: 3 columns */
  @media (min-width: 768px) {
    .stack-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  /* Desktop: 4 columns for first 8, then 2 centered */
  @media (min-width: 1024px) {
    .stack-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 3rem 2rem;
    }
    
    /* Last 2 items centered */
    .stack-grid > :nth-last-child(2),
    .stack-grid > :nth-last-child(1) {
      grid-column: span 2;
      justify-self: center;
    }
  }
</style>
