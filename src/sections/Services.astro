---
import ServiceCard from "../components/ServiceCard.astro";
import GradientText from "../components/GradientText.astro";
import { services } from "../data/services";
---

<section
  id="services"
  class="services-section mb-10 flex flex-col items-center justify-center py-12 md:py-20"
>
  <div class="flex flex-col items-center w-full max-w-2xl mx-auto shift-up-10">
    <img
      src="/codezone-logo-color.svg"
      alt="CodeZone"
      class="size-70 h-auto mb-4"
      loading="lazy"
    />
    <GradientText
      as="h2"
      gradient="cyan-purple"
      className="text-5xl font-medium text-center mb-4"
      style="letter-spacing:1px;"
    >
      Tech Your Vibes
    </GradientText>
    <div class="flex flex-col mt-9 max-w-md">
      <p class="text-sm text-pretty text-neutral-100 text-center mb-8">
        En Codezone convertimos lo que tu negocio busca y necesita en tecnología
        a medida, respetando su esencia y maximizando su valor.
      </p>
      <p
        class="text-sm text-pretty text-neutral-100 text-center mb-8"
      >
        Ayudamos a marcas y empresas a crear productos inspiradores, confiables
        y rentables.
      </p>
    </div>
  </div>

  <!-- Responsive Services Grid -->
  <div
    class={`services-grid grid grid-cols-1 md:place-items-center md:grid-cols-2 xl:grid-cols-3  gap-4 2xl:flex-row justify-center w-full mx-auto`}
  >
    {
      services.map((service, index) => (
         <div
          class={
              index === 2
                ? "flex h-full md:col-span-2 md:mx-auto md:max-w-[480px] md:max-h-416 xl:col-span-1 xl:mx-0"
                : index === 1
                ? "flex h-full shift-up-10"
                : "flex h-full "
          }
        >
          <ServiceCard
            title={service.title}
            description={service.description}
            image={service.image}
            cta={service.ctaText}
            ctaHref={service.ctaHref}
          />
        </div>
      ))
    }
  </div>
</section>

<style>
  .services-section {
    /* width: 100%; */
    /* padding: 4rem 4rem; */
  }
  
  .service-card-center {
      grid-column: auto;
    }

  /* Make grid rows equal height so cards stretch to the same size */
  .services-grid {
    grid-auto-rows: 1fr;
    max-width: var(--width-max-content);
  }

  @media (min-width: 1280px) {
    .shift-up-10 {
      transform: translateY(15%);
      z-index: 10;
    }
  }

</style>
