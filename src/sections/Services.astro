---
import ServiceCard from "../components/ServiceCard.astro";
import GradientText from "../components/GradientText.astro";
import { services } from "../data/services";
---

<section
  id="services"
  class="services-section lg:mb-20 flex flex-col items-center justify-center"
>
  <div class="flex flex-col items-center w-full max-w-2xl mx-auto shift-up-10">
    <img
      src="/codezone-logo-color.svg"
      alt="Logo de CodeZone"
      width="375"
      height="54"
      class="w-43 md:w- lg:w-[375px] h-auto mb-4"
      loading="lazy"
      decoding="async"
    />
    <GradientText
      as="h2"
      gradient="cyan-purple"
      className="text-4xl sm:text-5xl md:text-[64px] font-medium text-center mb-4"
      style="letter-spacing:1px;"
    >
      Tech Your Vibes
    </GradientText>
    <div class="flex flex-col mt-9 max-w-[504px] min-w-[342px] w-full px-4">
      <p class="paragraph-1 text-sm text-neutral-100 text-center mb-8">
        En Codezone convertimos lo que tu negocio busca y necesita en tecnología
        a medida, respetando su esencia y maximizando su valor.
      </p>
      <p class="paragraph-2 text-sm text-neutral-100 text-center mb-8">
        Ayudamos a marcas y empresas a crear productos inspiradores, confiables
        y rentables.
      </p>
    </div>
  </div>

  <!-- Responsive Services Grid -->
  <div
    class={`services-grid grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-10 justify-center w-full mx-auto`}
  >
    {
      services.map((service, index) => (
        <div
          class={
            index === 2
              ? "flex h-full md:col-span-2 md:justify-self-center md:w-[calc(50%-1.375rem)] xl:order-2 xl:col-span-1 xl:justify-self-auto xl:w-auto"
              : index === 1
                ? "flex h-full shift-up-10"
                : "flex h-full w-full"
          }
          data-card-index={index}
        >
          <ServiceCard
            title={service.title}
            description={service.description}
            image={service.image}
            cta={service.ctaText}
            ctaHref={service.ctaHref}
            className="service-card"
          />
        </div>
      ))
    }
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { maskTextRevealVertical } from "../utils/animations/text-animations";
  import {
    setupSectionAnimationRefresh,
    animateSeparatorAfterSection,
  } from "../utils/animations/animation-helpers";

  gsap.registerPlugin(ScrollTrigger);

  function initServicesAnimations() {
    const servicesSection = document.querySelector("#services");
    if (!servicesSection) return;

    const logo = servicesSection.querySelector("img");
    const claim = servicesSection.querySelector("h2");
    const p1 = servicesSection.querySelector(".paragraph-1");
    const p2 = servicesSection.querySelector(".paragraph-2");
    const cards = Array.from(servicesSection.querySelectorAll(".service-card"));
    const separator = document.querySelector("#process-separator");

    // Detectar tamaño de pantalla
    const isMobile = () => window.innerWidth <= 768;
    const isTablet = () => window.innerWidth > 768 && window.innerWidth <= 1279;

    // 1. Logo, se anima cuando está más dentro del viewport
    if (logo) {
      gsap.from(logo, {
        y: 60,
        opacity: 0,
        filter: "blur(10px)",
        duration: 0.6,
        ease: "power2.out",
        scrollTrigger: {
          trigger: logo,
          start: "top 80%",
          toggleActions: "play none none none",
        },
      });
    }

    // 2. Claim h2 con maskTextReveal2 (animación vertical)
    if (claim) {
      maskTextRevealVertical(claim, {
        duration: 0.5,
        stagger: 0.05,
        ease: "power3.out",
        scrollTrigger: {
          trigger: claim,
          start: "top 80%",
          toggleActions: "play none none none",
        },
      });
    }

    // 3. Párrafo 1
    if (p1) {
      gsap.from(p1, {
        y: 40,
        opacity: 0,
        filter: "blur(8px)",
        duration: 0.5,
        ease: "power2.out",
        scrollTrigger: {
          trigger: p1,
          start: "top 70%",
          toggleActions: "play none none none",
        },
      });
    }

    // 4. Párrafo 2
    if (p2) {
      gsap.from(p2, {
        y: 40,
        opacity: 0,
        filter: "blur(8px)",
        duration: 0.5,
        ease: "power2.out",
        scrollTrigger: {
          trigger: p2,
          start: "top 80%",
          toggleActions: "play none none none",
        },
      });
    }

    // 5. Cards - Animación según tamaño de pantalla
    if (cards.length > 0) {
      if (isMobile() || isTablet()) {
        cards.forEach((card, index) => {
          gsap.from(card, {
            y: 100,
            opacity: 0,
            rotate: index % 2 === 0 ? 10 : -10,
            duration: 0.5,
            ease: "power2.out",
            scrollTrigger: {
              trigger: card,
              start: "top 70%",
              toggleActions: "play none none none",
            },
          });
        });
      } else {
        // DESKTOP: Animación con scrub progresivo suave
        const card1 = cards[0];
        const card2 = cards[1];
        const card3 = cards[2];

        // Cards de los extremos (1 y 3) con ScrollTrigger individual
        if (card1) {
          gsap.from(card1, {
            y: 120,
            opacity: 0,
            rotate: 10,
            duration: 0.7,
            ease: "power2.out",
            scrollTrigger: {
              trigger: card1,
              start: "top 70%",
              end: "top 50%",
              toggleActions: "play none none none",
            },
          });
        }

        if (card3) {
          gsap.from(card3, {
            y: 120,
            opacity: 0,
            rotate: -10,
            duration: 0.7,
            ease: "power2.out",
            scrollTrigger: {
              trigger: card3,
              start: "top 70%",
              end: "top 50%",
              toggleActions: "play none none none",
            },
          });
        }

        // Card del centro (2) sin rotación
        if (card2) {
          gsap.from(card2, {
            y: 120,
            opacity: 0,
            rotate: 0,
            duration: 0.7,
            ease: "power2.out",
            scrollTrigger: {
              trigger: card2,
              start: "top 70%",
              end: "top 50%",
              toggleActions: "play none none none",
            },
          });
        }
      }
    }

    if (separator) {
      gsap.from(separator, {
        y: 50,
        opacity: 0,
        duration: 0.5,
        ease: "power3.out",
        scrollTrigger: {
          trigger: separator,
          start: "top 75%",
          toggleActions: "play none none none",
        },
      });
    }
  }

  // Inicializar cuando el DOM esté listo
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initServicesAnimations);
  } else {
    initServicesAnimations();
  }
  // Esto centraliza el comportamiento para todos los separadores.
  setupSectionAnimationRefresh({
    specialSectionIds: ["services-separator"],
    specialDelay: 150,
    includeResize: true,
    resizeDebounce: 250,
  });
  // Asegurar que el separador principal aparezca después de las animaciones de la sección
  // Retorna una función de cleanup si se necesita
  animateSeparatorAfterSection("#services", "#services-separator", {
    pollDelay: 150,
    timeout: 4000,
    finalDelay: 120,
  });
</script>

<style>
  .service-card-center {
    grid-column: auto;
  }

  /* Make grid rows equal height so cards stretch to the same size */
  .services-grid {
    grid-auto-rows: 1fr;
    max-width: var(--width-max-content);
  }

  @media (min-width: 1280px) {
    .shift-up-10 {
      transform: translateY(15%);
      z-index: var(--z-content);
    }
  }

  @media (max-width: 767px) {
    .services-section {
      margin: 0;
      padding: 0;
    }
  }

  /* Accessibility: Show content immediately if prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .services-section img,
    .services-section h2,
    .services-section p,
    .service-card {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>
