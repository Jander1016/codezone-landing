---
import ServiceCard from "../components/ServiceCard.astro";
import GradientText from "../components/GradientText.astro";
import { services } from "../data/services";
---

<section
  id="services"
  class="services-section flex flex-col items-center justify-center py-12 md:py-20"
>
  <div class="flex flex-col items-center w-full max-w-7xl mx-auto pb-8">
    <img
      src="/codezone-logo-color.svg"
      alt="CodeZone"
      class="size-70 h-auto mb-4"
      loading="lazy"
    />
    <GradientText
      as="h2"
      gradient="cyan-purple"
      className="text-5xl font-medium text-center mb-4"
      style="letter-spacing:1px;"
    >
      Tech Your Vibes
    </GradientText>
    <div class="flex flex-col mt-9">
      <p class="text-sm text-neutral-100 text-center mb-2 max-w-md">
        En Codezone convertimos lo que tu negocio busca y necesita en tecnología
        a medida, respetando su esencia y maximizando su valor.
      </p>
      <p
        class="text-sm text-neutral-100 text-center mb-8"
        style="max-width:410px;"
      >
        Ayudamos a marcas y empresas a crear productos inspiradores, confiables
        y rentables.
      </p>
    </div>
  </div>

  <!-- Responsive Services Grid -->
  <div
    class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:flex-row justify-center items-stretch gap-8 w-full mx-auto md:place-items-center max-w-[1532px]"
  >
    {
      services.map((service, index) => (
         <div
          class={
            index === 2
              ? "flex h-full md:col-span-2 md:mx-auto md:max-w-[360px] xl:col-span-1 xl:mx-0"
              : "flex h-full"
          }
        >
          <ServiceCard
            title={service.title}
            description={service.description}
            image={service.image}
            cta={service.ctaText}
            ctaHref={service.ctaHref}
          />
        </div>
      ))
    }
  </div>
</section>

<style>
  .services-section {
    width: 100%;
    /* min-height: 60vh; */
    padding: 4rem 1rem;
  }
  
  .service-card-center {
      grid-column: auto;
    }
  
