---
import ServiceCard from "../components/ServiceCard.astro";
import GradientText from "../components/GradientText.astro";
import { services } from "../data/services";
---

<section
  id="services"
  class="services-section lg:mb-20 flex flex-col items-center justify-center"
>
  <div class="flex flex-col items-center w-full max-w-2xl mx-auto shift-up-10">
    <img
      src="/codezone-logo-color.svg"
      alt="Logo de CodeZone"
      width="375"
      height="54"
      class="w-43 md:w- lg:w-[375px] h-auto mb-4"
      loading="lazy"
      decoding="async"
    />
    <GradientText
      as="h2"
      gradient="cyan-purple"
      className="textMaskReveal text-4xl sm:text-5xl md:text-[64px] font-medium text-center mb-4"
      style="letter-spacing:1px;"
    >
      Tech Your Vibes
    </GradientText>
    <div class="flex flex-col mt-9 max-w-[504px] min-w-[342px] w-full px-4">
      <p
        class="paragraph-1 text-sm text-pretty text-neutral-100 text-center mb-8"
      >
        En Codezone convertimos lo que tu negocio busca y necesita en tecnología
        a medida, respetando su esencia y maximizando su valor.
      </p>
      <p
        class="paragraph-2 text-sm text-pretty text-neutral-100 text-center mb-8"
      >
        Ayudamos a marcas y empresas a crear productos inspiradores, confiables
        y rentables.
      </p>
    </div>
  </div>

  <!-- Responsive Services Grid -->
  <div
    class={`services-grid services-cards-container grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-10 justify-center w-full mx-auto`}
  >
    {
      services.map((service, index) => (
        <div
          class={
            index === 2
              ? "service-card flex h-full md:col-span-2 md:mx-auto md:max-w-[480px] xl:col-span-1 xl:mx-0"
              : index === 1
                ? "service-card flex h-full shift-up-10"
                : "service-card flex h-full w-full"
          }
          data-card-index={index}
        >
          <ServiceCard
            title={service.title}
            description={service.description}
            image={service.image}
            cta={service.ctaText}
            ctaHref={service.ctaHref}
          />
        </div>
      ))
    }
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  // import { maskTextReveal } from "../utils/animations/text-animations";
  import { maskTextReveal2 } from "../utils/animations/text-animations2";

  gsap.registerPlugin(ScrollTrigger);

  function initServicesAnimations() {
    const servicesSection = document.querySelector("#services");
    if (!servicesSection) return;

    const logo = servicesSection.querySelector("img");
    const claim = servicesSection.querySelector(".textMaskReveal");
    const p1 = servicesSection.querySelector(".paragraph-1");
    const p2 = servicesSection.querySelector(".paragraph-2");
    const cards = Array.from(servicesSection.querySelectorAll(".service-card"));

    // Detectar tamaño de pantalla
    const isMobile = () => window.innerWidth <= 768;
    const isTablet = () => window.innerWidth > 768 && window.innerWidth <= 1279;
    // const isDesktop = () => window.innerWidth >= 1280;

    // 1. Logo, se anima cuando está más dentro del viewport
    if (logo) {
      gsap.from(logo, {
        y: 60,
        opacity: 0,
        filter: "blur(10px)",
        duration: 0.8,
        ease: "power2.out",
        scrollTrigger: {
          trigger: logo,
          start: "top 80%",
          toggleActions: "play none none none",
        },
      });
    }

    // 2. Claim h2 con maskTextReveal
    if (claim) {
      const titleTimeline = maskTextReveal2(claim, {
        duration: 0.6,
        stagger: 0.1,
        ease: "power3.out",
      });

      ScrollTrigger.create({
        trigger: claim,
        start: "top 80%",
        animation: titleTimeline,
        toggleActions: "play none none none",
      });

      // Crear timeline vacío si el elemento no existe
      // if (!claim) {
      //   console.warn(`maskTextReveal: Element not found - ${claim}`);
      //   return gsap.timeline();
      // }

      // // Obtener el texto y dividirlo en palabras
      // const text = claim.textContent || "";
      // const words = text.trim();

      // // Si no hay palabras, retornar timeline vacío
      // if (words.length === 0) {
      //   console.warn(`maskTextReveal: No text content found in element`);
      //   return gsap.timeline();
      // }

      // // Reemplazar el contenido con spans para cada palabra
      // // Usamos un wrapper con overflow hidden y padding para evitar cortar descendentes
      // claim.innerHTML = words
      //   .split(/\s+/)
      //   .map(
      //     (word) =>
      //       `<span class="word-mask"><span class="word">${word}&nbsp;</span></span>`,
      //   )
      //   .join("");

      // const wordElements = claim.querySelectorAll(".word");
      // gsap.set(wordElements, {
      //   yPercent: 100,
      //   autoAlpha: 0,
      //   opacity: 0,
      // });

      // // Crear y configurar la animación
      // const timeline = gsap.timeline({
      //   scrollTrigger: {
      //     trigger: claim,
      //     start: "top 80%", // La animación comienza cuando la parte superior del texto está a un 80% del viewport
      //     // markers: true, // Descomentar para ver los marcadores de ScrollTrigger (útil para depuración)
      //     toggleActions: "play none none none", // Solo se reproduce una vez
      //   },
      //   // delay: options?.delay || 0,
      //   // onComplete: options?.onComplete
      // });

      // // Animar los spans internos desde el estado inicial (yPercent:100, autoAlpha:0) hacia visible
      // timeline.to(wordElements, {
      //   yPercent: 0, // La palabra sube a su posición original
      //   autoAlpha: 1, // La palabra se hace visible
      //   opacity: 1,
      //   duration: 0.6, // Duración de la animación de CADA palabra
      //   ease: "power3.out", // Un suavizado fuerte para una subida con impacto
      //   // EL EFECTO PROGRESIVO:
      //   stagger: 0.08, // Retraso de 0.08 segundos entre el inicio de cada palabra
      // });
    }

    // 3. Párrafo 1
    if (p1) {
      gsap.from(p1, {
        y: 40,
        opacity: 0,
        filter: "blur(8px)",
        duration: 0.7,
        ease: "power2.out",
        scrollTrigger: {
          trigger: p1,
          start: "top 70%",
          toggleActions: "play none none none",
        },
      });
    }

    // 4. Párrafo 2
    if (p2) {
      gsap.from(p2, {
        y: 40,
        opacity: 0,
        filter: "blur(8px)",
        duration: 0.7,
        ease: "power2.out",
        scrollTrigger: {
          trigger: p2,
          start: "top 70%",
          toggleActions: "play none none none",
        },
      });
    }

    // 5. Cards - Animación según tamaño de pantalla
    if (cards.length > 0) {
      if (isMobile() || isTablet()) {
        // MOBILE/TABLET: Cards entran una por una SIN scrub
        cards.forEach((card, index) => {
          gsap.from(card, {
            y: 100,
            opacity: 0,
            rotate: index % 2 === 0 ? 10 : -10,
            duration: 0.8,
            ease: "power2.out",
            scrollTrigger: {
              trigger: card,
              start: "top 90%",
              toggleActions: "play none none none",
            },
          });
        });
      } else {
        // DESKTOP: Animación con scrub progresivo suave
        const card1 = cards[0];
        const card2 = cards[1];
        const card3 = cards[2];

        // Cards de los extremos (1 y 3) con ScrollTrigger individual
        if (card1) {
          gsap.from(card1, {
            y: 120,
            opacity: 0,
            rotate: 10,
            duration: 1.2,
            ease: "power2.out",
            scrollTrigger: {
              trigger: card1,
              start: "top 85%",
              end: "top 55%",
              scrub: 1,
              toggleActions: "play none none none",
            },
          });
        }

        if (card3) {
          gsap.from(card3, {
            y: 120,
            opacity: 0,
            rotate: -10,
            duration: 1.2,
            ease: "power2.out",
            scrollTrigger: {
              trigger: card3,
              start: "top 85%",
              end: "top 55%",
              scrub: 1,
              toggleActions: "play none none none",
            },
          });
        }

        // Card del centro (2) sin rotación
        if (card2) {
          gsap.from(card2, {
            y: 120,
            opacity: 0,
            rotate: 0,
            duration: 1.2,
            ease: "power2.out",
            scrollTrigger: {
              trigger: card2,
              start: "top 85%",
              end: "top 55%",
              scrub: 1,
              toggleActions: "play none none none",
            },
          });
        }
      }
    }
  }

  // Inicializar cuando el DOM esté listo
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initServicesAnimations);
  } else {
    initServicesAnimations();
  }

  // Escuchar evento de navegación programática para forzar animaciones
  document.addEventListener("trigger-section-animations", (event: Event) => {
    const customEvent = event as CustomEvent;
    const sectionId = customEvent.detail?.sectionId;

    // Si la navegación es a services, forzar refresh de ScrollTrigger
    if (sectionId === "services-separator") {
      setTimeout(() => {
        // Forzar refresh para recalcular posiciones
        ScrollTrigger.refresh();

        // Forzar que las animaciones se ejecuten inmediatamente
        const triggers = ScrollTrigger.getAll();
        triggers.forEach((trigger) => {
          if (
            trigger.trigger &&
            trigger.trigger.closest("#services-separator")
          ) {
            trigger.refresh();
          }
        });
      }, 150);
    }
  });

  // Refresh ScrollTrigger en resize para recalcular posiciones
  let resizeTimer: number;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      ScrollTrigger.refresh();
    }, 250);
  });
</script>

<style>
  .service-card-center {
    grid-column: auto;
  }

  /* Make grid rows equal height so cards stretch to the same size */
  .services-grid {
    grid-auto-rows: 1fr;
    max-width: var(--width-max-content);
  }

  @media (min-width: 1280px) {
    .shift-up-10 {
      transform: translateY(15%);
      z-index: var(--z-content);
    }
  }

  @media (max-width: 767px) {
    .services-section {
      margin: 0;
      padding: 0;
    }
  }

  /* Accessibility: Show content immediately if prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .services-section img,
    .services-section h2,
    .services-section p,
    .service-card {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>
