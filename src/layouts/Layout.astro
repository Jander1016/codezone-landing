---
import GradientOverlay from "../components/GradientOverlay.astro";
import Footer from "../sections/Footer.astro";
import Header from "../sections/Header.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>CodeZone</title>
		<link
			rel="icon"
			type="image/svg+xml"
			href="/codezone-logo-header.svg"
		/>
		<meta
			name="keywords"
			content="Código, proyectos, software, aplicaciones, codificación, desarrollo"
		/>
		<meta name="author" content="CodeZone" />
		<meta property="og:title" content="CodeZone" />
		<meta
			property="og:description"
			content="Desarrollo de páginas web, software a medida e integración de sistemas(APIs)."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://yourwebsite.com" />
		<meta
			property="og:image"
			content="https://yourwebsite.com/og-image.jpg"
		/>

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="CodeZone" />
		<meta name="twitter:site" content="@yourtwitterhandle" />
		<meta
			name="twitter:description"
			content="Desarrollo de páginas web, software a medida e integración de sistemas(APIs)."
		/>
	</head>
	<body>
		<!-- Preloader overlay (uses GSAP via /src/scripts/preloader.ts) -->
		<!-- <div id="preloader" class="preloader-overlay">
			<div class="loading-content">
				<div class="preloader-logo"><img src="/codezone-logo-header.svg" alt="CodeZone" /></div>
				<p class="loading-text">Cargando CodeZone</p>
				<div class="progress-bar-container"><div id="progressBar" class="progress-bar"></div></div>
			</div>
		</div> -->

		<!-- ScrollSmoother wrapper -->
		<div
			id="background-mask smooth-wrapper"
			class="relative z-1 w-full mx-auto px-4 sm:px-6 lg:px-8"
		>
			<div class="smooth-content relative z-2">
				<Header />
				<slot />
				<GradientOverlay
					position="bottom"
					size="small"
					color="fuchsia"
					opacity="medium"
					blur="high"
				>
					<Footer />
				</GradientOverlay>
			</div>
		</div>

		<!-- <script type="module" src="/src/scripts/preloader.ts"></script> -->

		<script>
			import { gsap } from "gsap";
			import { ScrollTrigger } from "gsap/ScrollTrigger";
			import { ScrollSmoother } from "gsap/ScrollSmoother";

			gsap.registerPlugin(ScrollTrigger, ScrollSmoother);

			// Inicializar ScrollSmoother
			function initScrollSmoother() {
				// Verificar que los elementos existen
				const wrapper = document.querySelector("#smooth-wrapper");
				const content = document.querySelector("#smooth-content");

				if (!wrapper || !content) {
					console.warn(
						"ScrollSmoother: wrapper or content not found",
					);
					return;
				}

				// Crear ScrollSmoother
				const smoother = ScrollSmoother.create({
					wrapper: "#smooth-wrapper",
					content: "#smooth-content",
					smooth: 1.5, // Suavidad del scroll (1-2 recomendado)
					effects: true, // Habilitar data-speed effects
					smoothTouch: 0.1, // Suavidad en touch devices (más bajo = menos suave)
					normalizeScroll: true, // Normalizar scroll en diferentes navegadores
					ignoreMobileResize: true, // Ignorar resize en mobile para mejor performance
				});

				// Guardar referencia global para acceso desde otros scripts
				(window as any).smoother = smoother;

				console.log("ScrollSmoother initialized");
			}

			// Inicializar cuando el DOM esté listo
			if (document.readyState === "loading") {
				document.addEventListener(
					"DOMContentLoaded",
					initScrollSmoother,
				);
			} else {
				initScrollSmoother();
			}
		</script>
	</body>
</html>

<style>
	body {
		background: #000;
		font-family: "Funnel Display", system-ui, sans-serif;
		/* font-optical-sizing: auto; */
		letter-spacing: 0.5px;
		color: var(--neutral-50);
		margin: 0;
		font-size: 18px;
		overflow-x: hidden;
		background: url(/grid-100x100.svg), var(--primary-blue);
	}

	/* ScrollSmoother required styles */
	#smooth-wrapper {
		overflow: hidden;
		position: fixed;
		height: 100%;
		width: 100%;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
	}

	#smooth-content {
		overflow: visible;
		width: 100%;
		/* Set a height to enable scrolling */
		will-change: transform;
	}

	#background-mask {
		width: 100%;
		min-height: 100%;
		margin: 0px;
		/* background-size: 340px, cover; */
	}

	/* Preloader styles (minimal, adapted from provided example) */
	.preloader-overlay {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100vh;
		background: #080c1d;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}
	.loading-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		color: #f0f8ff;
		z-index: 10001;
	}
	.preloader-logo img {
		width: 125px;
		height: auto;
		margin-bottom: 12px;
	}
	.loading-text {
		color: #53eafd;
		margin-bottom: 12px;
	}
	.progress-bar-container {
		width: 300px;
		height: 4px;
		background: rgba(83, 234, 253, 0.12);
		border-radius: 4px;
		overflow: hidden;
	}
	.progress-bar {
		height: 100%;
		width: 0%;
		background: #53eafd;
		box-shadow: 0 0 15px 2px #53eafd;
		transition: width 0.25s linear;
	}

	/* initial hidden state for animated elements (kept for compatibility with scripts) */
	.topnav,
	.hero-title,
	.hero-subtitle,
	.btn-cta,
	.hero-image,
	.separator {
		opacity: 0;
	}
</style>
