---
import Footer from "../sections/Footer.astro";
import Header from "../sections/Header.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- DNS Prefetch y Preconnect para Netlify CDN - Aparecen primero para optimizar conexiones -->
		<link rel="dns-prefetch" href="https://codezone-v1.netlify.app" />
		<link
			rel="preconnect"
			href="https://codezone-v1.netlify.app"
			crossorigin
		/>

		<title>CodeZone - Desarrollo Web y Software a Medida</title>
		<link
			rel="icon"
			type="image/svg+xml"
			href="/codezone-logo-header.svg"
		/>

		<!-- Preload SOLO fuentes críticas (600 y 700) para mejor rendimiento -->
		<link
			rel="preload"
			href="/fonts/funnel-display-v3-latin-500.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/funnel-display-v3-latin-600.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<!-- Meta tags optimizados para SEO -->
		<meta
			name="description"
			content="Desarrollo de páginas web, software a medida e integración de sistemas (APIs). Expertos en soluciones digitales personalizadas."
		/>
		<meta
			name="keywords"
			content="desarrollo web, software a medida, APIs, integración de sistemas, CodeZone"
		/>
		<meta name="author" content="CodeZone" />

		<!-- Open Graph -->
		<meta
			property="og:title"
			content="CodeZone - Desarrollo Web y Software"
		/>
		<meta
			property="og:description"
			content="Desarrollo de páginas web, software a medida e integración de sistemas (APIs)."
		/>
		<meta property="og:type" content="website" />
	</head>
	<body>
		<Header />
		<div
			id="background-mask"
			class="relative z-1 w-full mx-auto px-4 sm:px-6 lg:px-8"
		>
			<div class="relative z-2">
				<main id="main-content" tabindex="-1">
					<slot />
				</main>
			</div>
		</div>
		<Footer />
	</body>
</html>

<script>
	import Lenis from "lenis";

	const DESKTOP_BREAKPOINT = 1024;
	let lenis: Lenis | null = null;

	function isDesktop(): boolean {
		return window.innerWidth >= DESKTOP_BREAKPOINT;
	}

	function initLenis() {
		if (!isDesktop()) {
			return;
		}

		lenis = new Lenis({
			lerp: 0.03,
			orientation: "vertical",
			gestureOrientation: "vertical",
			smoothWheel: true,
			syncTouch: false,
			wheelMultiplier: 2,
			touchMultiplier: 2,
		});

		function raf(time: number) {
			if (lenis) {
				lenis.raf(time);
			}
			requestAnimationFrame(raf);
		}

		requestAnimationFrame(raf);
	}

	function destroyLenis() {
		if (lenis) {
			lenis.destroy();
			lenis = null;
		}
	}

	function handleResize() {
		const nowDesktop = isDesktop();
		const hasLenis = lenis !== null;

		if (nowDesktop && !hasLenis) {
			initLenis();
		} else if (!nowDesktop && hasLenis) {
			destroyLenis();
		}
	}

	// Initialize on load
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", () => {
			initLenis();
			window.addEventListener("resize", handleResize);
		});
	} else {
		initLenis();
		window.addEventListener("resize", handleResize);
	}
</script>

<style>
	html {
		width: 100%;
		min-height: 100%;
		scroll-behavior: initial;
	}

	html,
	body {
		width: 100%;
		overscroll-behavior: none;
		min-height: 100%;
		/* height: 100%; */
	}

	/* Hide scrollbar on mobile, show on desktop */
	@media (max-width: 1023px) {
		::-webkit-scrollbar {
			display: none;
		}

		* {
			scrollbar-width: none;
			-ms-overflow-style: none;
		}
	}

	/* Desktop scrollbar styles */
	@media (min-width: 1024px) {
		::-webkit-scrollbar {
			width: 15px;
		}

		::-webkit-scrollbar-track {
			background: #000c23;
		}

		::-webkit-scrollbar-thumb {
			background-color: #1e3e7b;
			border-radius: 8px;
			border: 2px solid #1e3e7b;
		}

		* {
			scrollbar-width: thin;
			scrollbar-color: #1e3e7b #18181b;
		}
	}

	body {
		font-family: "Funnel Display", system-ui, sans-serif;
		letter-spacing: 0.5px;
		color: var(--neutral-50);
		margin: 0;
		font-size: 18px;
		overflow-x: hidden;
		background: url(/grid-100x100.svg), var(--primary-blue);
	}

	#background-mask {
		width: 100%;
		min-height: 100dvh;
		margin: 0px;
	}

	header {
		position: fixed;
		z-index: var(--z-header);
		opacity: 0;
		pointer-events: none;
	}

	header.is-visible {
		pointer-events: auto;
	}


	.loading-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		color: #f0f8ff;
		z-index: calc(var(--z-preloader) + 1);
	}

	.preloader-logo img {
		width: 125px;
		height: auto;
		margin-bottom: 12px;
	}
	.loading-text {
		color: #53eafd;
		margin-bottom: 12px;
	}
	.progress-bar-container {
		width: 300px;
		height: 4px;
		background: rgba(83, 234, 253, 0.12);
		border-radius: 4px;
		overflow: hidden;
	}
	.progress-bar {
		height: 100%;
		width: 0%;
		background: #53eafd;
		box-shadow: 0 0 15px 2px #53eafd;
		transition: width 0.25s linear;
	}

	/* Estado inicial oculto para elementos animados (mantenido para compatibilidad con scripts) */
	.topnav,
	.hero-title,
	.hero-subtitle,
	.btn-cta,
	.hero-image,
	.separator {
		opacity: 0;
	}
</style>
