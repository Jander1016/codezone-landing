<style>
	body {
		background: #000;
		font-family: "Funnel Display", system-ui, sans-serif;
		/* font-optical-sizing: auto; */
		letter-spacing: 0.5px;
		color: var(--neutral-50);
		margin: 0;
		font-size: 18px;
		/* width: 100%;
		height: 100%; */
		/* background: url(/grid-100x100.svg), var(--primary-blue); */
	}

	#background-mask {
		width: 100%;
		min-height: 100%;
		margin: 0px;
		background: url(/grid-100x100.svg), var(--primary-blue);
		/* background-size: 340px, cover; */
	}

/* Preloader styles (minimal, adapted from provided example) */
.preloader-overlay {
	position: fixed;
	inset: 0;
	width: 100%;
	height: 100vh;
	background: #080c1d;
	z-index: 9999;
	display: flex;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}
.loading-content {
	display: flex;
	flex-direction: column;
	align-items: center;
	color: #f0f8ff;
	z-index: 10001;
}
.preloader-logo img { width: 125px; height: auto; margin-bottom: 12px; }
.loading-text { color: #53EAFD; margin-bottom: 12px; }
.progress-bar-container { width: 300px; height: 4px; background: rgba(83,234,253,0.12); border-radius: 4px; overflow: hidden; }
.progress-bar { height: 100%; width: 0%; background: #53EAFD; box-shadow: 0 0 15px 2px #53EAFD; transition: width 0.25s linear; }

/* initial hidden state for animated elements (kept for compatibility with scripts) */
.topnav, .hero-title, .hero-subtitle, .btn-cta, .hero-image, .separator { opacity: 0; }

</style>
