<script>
	import Lenis from "lenis";
	const lenis = new Lenis({
		// duration: 1.2,
		// easing: (t) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t)),
		lerp: 0.03,
		orientation: "vertical",
		gestureOrientation: "vertical",
		smoothWheel: true,
		syncTouch: false,
		wheelMultiplier: 2,
		// touchMultiplier: 2,
	});

	function raf(time: number) {
		lenis.raf(time);
		requestAnimationFrame(raf);
	}

	requestAnimationFrame(raf);
</script>

<style>
	html {
		width: 100%;
		min-height: 100%;
		scroll-behavior: initial;
	}

	html,
	body {
		width: 100%;
		overscroll-behavior: none;
		min-height: 100%;
		/* height: 100%; */
	}

	::-webkit-scrollbar {
		width: 15px;
	}

	::-webkit-scrollbar-track {
		background: #000c23;
	}

	::-webkit-scrollbar-thumb {
		background-color: #1e3e7b;
		border-radius: 8px;
		border: 2px solid #1e3e7b;
	}

	* {
		scrollbar-width: 15px;
		scrollbar-color: #1e3e7b #18181b;
	}

	body {
		font-family: "Funnel Display", system-ui, sans-serif;
		letter-spacing: 0.5px;
		color: var(--neutral-50);
		margin: 0;
		font-size: 18px;
		overflow-x: hidden;
		background: url(/grid-100x100.svg), var(--primary-blue);
	}

	/* ScrollSmoother DESACTIVADO - usando scroll nativo */
	/* #smooth-wrapper {
		width: 100%;
		min-height: 100vh;
	}

	#smooth-content {
		width: 100%;
		min-height: 100vh;
	} */

	#background-mask {
		width: 100%;
		min-height: 100dvh;
		margin: 0px;
	}

	/* Header debe quedar por encima del ScrollSmoother */
	header {
		position: sticky;
		z-index: var(--z-header);
		opacity: 0;
		pointer-events: none;
	}

	/* Habilitar clicks cuando el header es visible */
	header.is-visible {
		pointer-events: auto;
	}

	/* Estilos del preloader (mínimos, adaptados del ejemplo proporcionado) */
	.preloader-overlay {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100dvh;
		background: #080c1d;
		z-index: var(--z-preloader);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.loading-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		color: #f0f8ff;
		z-index: calc(var(--z-preloader) + 1);
	}

	.preloader-logo img {
		width: 125px;
		height: auto;
		margin-bottom: 12px;
	}
	.loading-text {
		color: #53eafd;
		margin-bottom: 12px;
	}
	.progress-bar-container {
		width: 300px;
		height: 4px;
		background: rgba(83, 234, 253, 0.12);
		border-radius: 4px;
		overflow: hidden;
	}
	.progress-bar {
		height: 100%;
		width: 0%;
		background: #53eafd;
		box-shadow: 0 0 15px 2px #53eafd;
		transition: width 0.25s linear;
	}

	/* Estado inicial oculto para elementos animados (mantenido para compatibilidad con scripts) */
	.topnav,
	.hero-title,
	.hero-subtitle,
	.btn-cta,
	.hero-image,
	.separator {
		opacity: 0;
	}

	@media (max-width: 1024px) {
		html,
		body {
			overflow-y: hidden;
		}
	}

</style>
