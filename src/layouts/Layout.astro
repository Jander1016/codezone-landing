---
import Footer from "../sections/Footer.astro";
import Header from "../sections/Header.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>CodeZone</title>
		<link
			rel="icon"
			type="image/svg+xml"
			href="/codezone-logo-header.svg"
		/>

		<!-- Precarga de fuentes críticas para mejor rendimiento -->
		<link
			rel="preload"
			href="/fonts/funnel-display-v3-latin-500.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>

		<meta
			name="keywords"
			content="Código, proyectos, software, aplicaciones, codificación, desarrollo"
		/>
		<meta name="author" content="CodeZone" />
		<meta
			name="description"
			content="Desarrollo de páginas web, software a medida e integración de sistemas(APIs)."
		/>

		<meta property="og:title" content="CodeZone" />
		<meta
			property="og:description"
			content="Desarrollo de páginas web, software a medida e integración de sistemas(APIs)."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://yourwebsite.com" />
		<meta
			property="og:image"
			content="https://yourwebsite.com/og-image.jpg"
		/>

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="CodeZone" />
		<meta name="twitter:site" content="@yourtwitterhandle" />
		<meta
			name="twitter:description"
			content="Desarrollo de páginas web, software a medida e integración de sistemas(APIs)."
		/>
	</head>
	<body>
		<Header />

		<!-- <div id="smooth-wrapper">
			<div id="smooth-content" class="overflow-hidden"> -->
				<div
					id="background-mask"
					class="relative z-1 w-full mx-auto px-4 sm:px-6 lg:px-8"
				>
					<div class="relative z-2">
						<main id="main-content" tabindex="-1">
							<slot />
						</main>
						<!-- <GradientOverlay
							position="bottom"
							size="small"
							color="fuchsia"
							opacity="low"
							blur="high"
						> -->
						<Footer />
						<!-- </GradientOverlay> -->
					</div>
				</div>
			<!-- </div>
		</div> -->
	</body>
</html>
