---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>CodeZone</title>
		<meta
			name="keywords"
			content="code, projects, experiments, coding, development"
		/>
		<meta name="author" content="CodeZone" />
		<meta property="og:title" content="CodeZone" />
		<meta
			property="og:description"
			content="Desarrollo de páginas web, software a medida e integración de sistemas(APIs)."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://yourwebsite.com" />
		<meta property="og:image" content="https://yourwebsite.com/og-image.jpg" />
	</head>
	<body>
		<div
			id="background-mask"
			class="relative z-1 w-full mx-auto px-4 sm:px-6 lg:px-8"
		>
			<div class="relative z-2">
				<slot />
			</div>
		</div>
	</body>
</html>

<style>
	body {
		background: #000;
		font-family: "Funnel Display", system-ui, sans-serif;
		/* font-optical-sizing: auto;
		font-weight: 300;
		font-style: normal; */
		letter-spacing: 0.5px;
		color: var(--neutral-50);
		margin: 0;
		font-size: 18px;
		/* font-size: clamp(1rem, 0.9591rem + 0.1818vw, 1.25rem); */
		/* width: 100%;
		height: 100%; */
	}

	#background-mask {
		width: 100%;
		min-height: 100%;
		margin: 0px;
		background: url(/grid-100x100.svg), var(--primary-blue);
	}
</style>
