---
import { PROCESS_STEPS } from "../data/process";
---

<section
    class="visual-accordion-section relative overflow-hidden border border-[rgba(83,234,253,0.25)] px-5 py-4 md:px-20 lg:px-31 pt-4 md:pt-6 lg:pt-8 mx-auto rounded-3xl md:rounded-4xl"
>
    <video
        autoplay
        loop
        muted
        playsinline
        class="absolute top-0 left-0 w-full h-full object-cover -z-10"
    >
        <source src="/videos/fondo-acordeon.webm" type="video/webm" />
    </video>
    <div class="w-full flex flex-col relative z-10 gap-2 lg:gap-5">
        {
            PROCESS_STEPS.map((item, index) => (
                <div
                    class="accordion-item flex flex-col gap-2 lg:gap-5 cursor-pointer"
                    data-tab={String(index + 1).padStart(2, "0")}
                >
                    <div class="accordion-header">
                        <h3 class="item-title font-bold">{item.title}</h3>
                        <span class="icon">»</span>
                    </div>
                    <div class="accordion-content">
                        <div class="overflow-hidden">
                            <p class="font-medium">{item.description}</p>
                        </div>
                    </div>
                    <div
                        class={`w-full h-px bg-[rgba(83,234,253,0.25)] ${index === PROCESS_STEPS.length - 1 ? "hidden" : ""}`}
                    />
                </div>
            ))
        }
    </div>
</section>

<style>
    .accordion-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: var(--font-size-subtitle);
        font-weight: 600;
        transition: color 0.3s ease;
        will-change: color;
    }

    .accordion-header:hover {
        color: var(--cyan-300);
    }

    .icon {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--cyan-300);
        opacity: 0.5;
        transform: rotate(-45deg);
        transition:
            all 0.3s ease-out,
            color 0.3s ease-out;
    }

    .accordion-content {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.7s cubic-bezier(0.19, 1, 0.22, 1);
        will-change: grid-template-rows;
    }
    
    .accordion-item.active .accordion-header {
        color: var(--cyan-300);
    }

    .accordion-item.active .accordion-content {
        grid-template-rows: 1fr;
    }

    .accordion-item.active .icon {
        opacity: 1;
        transform: rotate(0deg);
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const items = document.querySelectorAll(".accordion-item");

        function toggleAccordion(clickedItem: Element) {
            let shouldOpenFirst = false;

            items.forEach((item) => {
                if (item === clickedItem && item.classList.contains("active")) {
                    item.classList.remove("active");
                    shouldOpenFirst = true;
                } else if (item === clickedItem) {
                    item.classList.add("active");
                    shouldOpenFirst = false;
                } else {
                    item.classList.remove("active");
                }
            });

            const activeItemsCount = document.querySelectorAll(
                ".accordion-item.active",
            ).length;

            if (shouldOpenFirst && activeItemsCount === 0) {
                items[0].classList.add("active");
            }
        }

        // Inicialización: Abrir el primer ítem
        if (items.length > 0) {
            items[0].classList.add("active");
        }

        // Agregar listeners
        items.forEach((item) => {
            const header = item.querySelector(".accordion-header");
            header?.addEventListener("click", () => {
                toggleAccordion(item);
            });
        });
    });
</script>
