---
type SizeValue = 'small' | 'medium' | 'large' | 'xlarge';
type OpacityValue = 'low' | 'medium' | 'high';
type BlurValue = 'low' | 'medium' | 'high';

export interface Props {
  className?: string;
  position?: 'top' | 'center' | 'bottom' | 'top-right' | 'top-left' | 'bottom-right' | 'bottom-left';
  color?: 'cyan' | 'fuchsia';
  
  // Offset vertical personalizado (ej: '-top-50', 'top-1/4', '-bottom-20')
  offsetY?: string;
  
  // Responsive props - pueden ser un valor único o un objeto con breakpoints
  size?: SizeValue | { base?: SizeValue; sm?: SizeValue; md?: SizeValue; lg?: SizeValue; xl?: SizeValue };
  opacity?: OpacityValue | { base?: OpacityValue; sm?: OpacityValue; md?: OpacityValue; lg?: OpacityValue; xl?: OpacityValue };
  blur?: BlurValue | { base?: BlurValue; sm?: BlurValue; md?: BlurValue; lg?: BlurValue; xl?: BlurValue };
}

const { 
  className = "", 
  position = "center",
  offsetY,
  size = "large",
  color = "cyan",
  opacity = "medium",
  blur = "high"
} = Astro.props;

// Helper para normalizar valores responsive
const normalizeResponsive = <T extends string>(value: T | { base?: T; sm?: T; md?: T; lg?: T; xl?: T }, defaultValue: T) => {
  if (typeof value === 'object' && value !== null && !Array.isArray(value)) {
    const obj = value as { base?: T; sm?: T; md?: T; lg?: T; xl?: T };
    return {
      base: obj.base || defaultValue,
      sm: obj.sm,
      md: obj.md,
      lg: obj.lg,
      xl: obj.xl
    };
  }
  return { base: value as T, sm: undefined, md: undefined, lg: undefined, xl: undefined };
};

const sizeResponsive = normalizeResponsive(size, 'large' as SizeValue);
const opacityResponsive = normalizeResponsive(opacity, 'medium' as OpacityValue);
const blurResponsive = normalizeResponsive(blur, 'high' as BlurValue);

// Tailwind classes for position - ajustado para mejor visualización
const basePositionClasses = {
  'top': 'before:left-1/2 before:-translate-x-1/2 before:-translate-y-1/2',
  'center': 'before:left-1/2 before:-translate-x-1/2 before:-translate-y-1/2',
  'bottom': 'before:left-1/2 before:-translate-x-1/2 before:translate-y-1/2',
  'top-right': 'before:right-0 before:translate-x-1/3',
  'top-left': 'before:left-0 before:-translate-x-1/3',
  'bottom-right': 'before:right-0 before:translate-x-1/3',
  'bottom-left': 'before:left-0 before:-translate-x-1/3'
};

// Posiciones verticales por defecto
const defaultVerticalPosition = {
  'top': 'before:top-0',
  'center': 'before:top-1/2',
  'bottom': 'before:bottom-0',
  'top-right': 'before:top-1/4',
  'top-left': 'before:top-1/4',
  'bottom-right': 'before:bottom-1/4',
  'bottom-left': 'before:bottom-1/4'
};

// Si hay offsetY personalizado, usarlo; si no, usar el default
const verticalPosition = offsetY ? `before:${offsetY}` : defaultVerticalPosition[position];
const positionClass = `${basePositionClasses[position]} ${verticalPosition}`;

// Configuraciones de valores
const sizeConfig = {
  'small': '60vmin',
  'medium': '80vmin',
  'large': '100vmin',
  'xlarge': '140vmin'
};

const opacityConfig = {
  'low': '0.4',
  'medium': '0.6',
  'high': '0.8'
};

const blurConfig = {
  'low': '30px',
  'medium': '50px',
  'high': '80px'
};

// Gradientes de un solo color
const gradientConfig = {
  'cyan': `
    radial-gradient(
      circle at center,
      rgba(83, 234, 253, 0.8) 0%,
      rgba(83, 234, 253, 0.5) 30%,
      rgba(18, 29, 69, 0.3) 60%,
      rgba(18, 29, 69, 0) 100%
    )
  `,
  'fuchsia': `
    radial-gradient(
      circle at center,
      rgba(200, 0, 222, 0.8) 0%,
      rgba(200, 0, 222, 0.5) 30%,
      rgba(18, 29, 69, 0.3) 60%,
      rgba(18, 29, 69, 0) 100%
    )
  `
};

// Generar CSS custom properties para cada breakpoint
const generateResponsiveVars = () => {
  const vars: Record<string, string> = {};
  
  // Base values
  vars['--gradient-size'] = sizeConfig[sizeResponsive.base as SizeValue];
  vars['--gradient-opacity'] = opacityConfig[opacityResponsive.base as OpacityValue];
  vars['--gradient-blur'] = blurConfig[blurResponsive.base as BlurValue];
  
  // Breakpoint values
  if (sizeResponsive.sm) vars['--gradient-size-sm'] = sizeConfig[sizeResponsive.sm as SizeValue];
  if (sizeResponsive.md) vars['--gradient-size-md'] = sizeConfig[sizeResponsive.md as SizeValue];
  if (sizeResponsive.lg) vars['--gradient-size-lg'] = sizeConfig[sizeResponsive.lg as SizeValue];
  if (sizeResponsive.xl) vars['--gradient-size-xl'] = sizeConfig[sizeResponsive.xl as SizeValue];
  
  if (opacityResponsive.sm) vars['--gradient-opacity-sm'] = opacityConfig[opacityResponsive.sm as OpacityValue];
  if (opacityResponsive.md) vars['--gradient-opacity-md'] = opacityConfig[opacityResponsive.md as OpacityValue];
  if (opacityResponsive.lg) vars['--gradient-opacity-lg'] = opacityConfig[opacityResponsive.lg as OpacityValue];
  if (opacityResponsive.xl) vars['--gradient-opacity-xl'] = opacityConfig[opacityResponsive.xl as OpacityValue];
  
  if (blurResponsive.sm) vars['--gradient-blur-sm'] = blurConfig[blurResponsive.sm as BlurValue];
  if (blurResponsive.md) vars['--gradient-blur-md'] = blurConfig[blurResponsive.md as BlurValue];
  if (blurResponsive.lg) vars['--gradient-blur-lg'] = blurConfig[blurResponsive.lg as BlurValue];
  if (blurResponsive.xl) vars['--gradient-blur-xl'] = blurConfig[blurResponsive.xl as BlurValue];
  
  return vars;
};

const gradientStyle = gradientConfig[color];
const responsiveVars = generateResponsiveVars();
---

<div 
  class={`relative w-full overflow-hidden ${positionClass} ${className}`}
  style={`--gradient-style: ${gradientStyle}; ${Object.entries(responsiveVars).map(([key, value]) => `${key}: ${value}`).join('; ')};`}
>
  <slot />
</div>

<style>
  /* Base gradient styles with responsive support */
  div::before {
    content: '';
    position: absolute;
    z-index: -10;
    pointer-events: none;
    border-radius: 50%;
    
    /* Base values */
    width: var(--gradient-size, 100vmin);
    height: var(--gradient-size, 100vmin);
    opacity: var(--gradient-opacity, 0.6);
    filter: blur(var(--gradient-blur, 80px));
    
    /* Gradient */
    background: var(--gradient-style);
    background-blend-mode: screen;
    
    /* Performance optimizations */
    will-change: transform, opacity;
    contain: layout style paint;
  }
  
  /* Responsive breakpoints */
  @media (min-width: 640px) {
    div::before {
      width: var(--gradient-size-sm, var(--gradient-size, 100vmin));
      height: var(--gradient-size-sm, var(--gradient-size, 100vmin));
      opacity: var(--gradient-opacity-sm, var(--gradient-opacity, 0.6));
      filter: blur(var(--gradient-blur-sm, var(--gradient-blur, 80px)));
    }
  }
  
  @media (min-width: 768px) {
    div::before {
      width: var(--gradient-size-md, var(--gradient-size, 100vmin));
      height: var(--gradient-size-md, var(--gradient-size, 100vmin));
      opacity: var(--gradient-opacity-md, var(--gradient-opacity, 0.6));
      filter: blur(var(--gradient-blur-md, var(--gradient-blur, 80px)));
    }
  }
  
  @media (min-width: 1024px) {
    div::before {
      width: var(--gradient-size-lg, var(--gradient-size, 100vmin));
      height: var(--gradient-size-lg, var(--gradient-size, 100vmin));
      opacity: var(--gradient-opacity-lg, var(--gradient-opacity, 0.6));
      filter: blur(var(--gradient-blur-lg, var(--gradient-blur, 80px)));
    }
  }
  
  @media (min-width: 1280px) {
    div::before {
      width: var(--gradient-size-xl, var(--gradient-size, 100vmin));
      height: var(--gradient-size-xl, var(--gradient-size, 100vmin));
      opacity: var(--gradient-opacity-xl, var(--gradient-opacity, 0.6));
      filter: blur(var(--gradient-blur-xl, var(--gradient-blur, 80px)));
    }
  }
</style>
