---
 export interface Props {
  className?: string;
 }
  const { className = "" } = Astro.props;
--- 

<div
  class={`gradient-overlay w-full h-full ${className}`}
>
  <slot />
</div>

<style>
  .gradient-overlay {
    background: radial-gradient(
      ellipse,
      rgba(83, 234, 253, 0.35) 0%,
      rgba(18, 29, 69, 1) 35%,
      rgba(18, 29, 69, 0) 90%
    );
    backdrop-filter: blur(50px);
  }
</style>
