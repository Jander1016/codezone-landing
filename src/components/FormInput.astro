---
import type { FormInputProps } from '../types/components';

interface Props extends FormInputProps {}

const {
  type = 'text',
  name,
  label,
  placeholder = '',
  required = false,
  error = '',
  value = ''
} = Astro.props;

const inputId = `input-${name}`;
const errorId = `error-${name}`;
const hasError = error && error.length > 0;
---

<div class="form-input-wrapper">
  <label for={inputId} class="form-label">
    {label}
    {required && <span class="text-red-400">*</span>}
  </label>
  
  {type === 'textarea' ? (
    <textarea
      id={inputId}
      name={name}
      placeholder={placeholder}
      required={required}
      autocomplete="off"
      aria-required={required ? 'true' : 'false'}
      aria-invalid={hasError ? 'true' : 'false'}
      aria-describedby={hasError ? errorId : undefined}
      class:list={['form-textarea', { 'form-input-error': hasError }]}
    >{value}</textarea>
  ) : (
    <input
      id={inputId}
      type={type}
      name={name}
      placeholder={placeholder}
      value={value}
      required={required}
      autocomplete="off"
      aria-required={required ? 'true' : 'false'}
      aria-invalid={hasError ? 'true' : 'false'}
      aria-describedby={hasError ? errorId : undefined}
      class:list={['form-input', { 'form-input-error': hasError }]}
    />
  )}
  
  {hasError && (
    <span id={errorId} class="form-error" role="alert" aria-live="polite">
      {error}
    </span>
  )}
</div>

<style>
  .form-input-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .form-label {
    font-size: 0.875rem;
    color: #f5f5f5;
    font-weight: 500;
    text-align: left;
    margin-bottom: 0.25rem;
    margin-left: 0.25rem;;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background: transparent;
    border: 2px solid rgba(83, 233, 253, 0.3);
    color: #fcfcfc;
    font-size: 1rem;
    transition: all 300ms ease;
    outline: none;
  }
  
  .form-input {
    border-radius: 32px;
  }

  .form-textarea {
    min-height: 120px;
    resize: vertical;
    font-family: inherit;
    border-radius: 24px;
  }

  .form-input:focus,
  .form-textarea:focus {
    border-color: transparent;
    background-image: linear-gradient(
        180deg,
        rgba(18, 29, 70, 1) 0%,
        rgba(18, 29, 70, 1) 50%
      ),
      linear-gradient(90deg, #C800DE 0%, #53EAFD 100%);
    background-clip: padding-box, border-box;
    background-origin: border-box;
  }

  .form-input-error {
    border-color: rgb(239, 68, 68) !important;
  }

  .form-error {
    font-size: 0.875rem;
    color: rgb(239, 68, 68);
    margin-top: -0.25rem;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: rgba(212, 212, 212, 0.5);
  }
</style>
