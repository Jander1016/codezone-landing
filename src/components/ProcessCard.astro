---
import type { ProcessCardProps } from "../types/components";

interface Props extends ProcessCardProps {}

const { number, title, description, image, isEven = false } = Astro.props;
---

<article class:list={["process-card", { "process-card-reverse": isEven }]}>
  <div class="process-content">
    <h3 class="text-4xl text-cyan-300 font-medium">
      {title}
    </h3>
    <p class="process-description">
      {description}
    </p>
  </div>
  <div class="process-image-wrapper outer-glow-fx relative max-w-[630px] w-full sm:mx-0">
    <div
      class="process-badge absolute -top-6 -left-10 p-4 rounded-4xl z-10 font-medium linear-gradient-primary text-5xl text-cyan-300 flex items-center justify-center w-20 h-15"
    >
      {number}
    </div>
    <div class="card-image overflow-hidden">
      <img
        src={image}
        alt={title}
        class="process-image"
        loading="lazy"
        width="590"
        height="190"
      />
    </div>
  </div>
</article>

<style>
  .process-card{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    opacity: 1;
    transform: none;
    transition: none;
  }

  .process-image-wrapper {
    order: 1;
  }

  .process-content {
    order: 2;
  }

  .process-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .process-image-wrapper {
    width: 100%;
    max-width: 630px;
    position: relative;
  }
  
  .card-image {
    width: 100%;
    overflow: hidden;
    border-radius: 20px;
    display: block;
    border: 2px solid #53eafd26;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: all 600ms ease-in-out;
  }

  .process-image-wrapper:hover .card-image img {
    transform: scale(1.15);
  }

  .linear-gradient-primary {
    background-image: linear-gradient(
        180deg,
        rgba(2, 6, 24, 1) 0%,
        rgba(18, 29, 70, 1) 50%
      ),
      linear-gradient(45deg, var(--fuchsia-600), var(--cyan-300));
    background-clip: padding-box, border-box;
    background-origin: border-box;
    border: 2px solid transparent;
  }
  
  /* EFECTO HOVER EN CARD - PRESERVED */
  .outer-glow-fx .card-image {
    /* -webkit-box-shadow: 0px 0px 0px 0px rgba(83, 233, 253, 0.75);
    -moz-box-shadow: 0px 0px 0px 0px rgba(83, 233, 253, 0.75); */
    box-shadow: 0px 0px 0px 0px #02061866;
    transition: all 600ms ease-in-out;
  }

  .outer-glow-fx:hover .card-image {
    /* -webkit-box-shadow: 0px 0px 20px 0px rgba(83, 233, 253, 0.6);
    -moz-box-shadow: 0px 0px 20px 0px rgba(83, 233, 253, 0.6);*/
    /* box-shadow: 0px 0px 20px 0px rgba(83, 233, 253, 0.6);  */
    box-shadow: 0px 15px 25px 0px #02061866;
    border-color: rgba(83, 233, 253, 0.3);
    transition: all 300ms ease-in-out;
  }

  /* Desktop alternating layout */
  @media (min-width: 768px) {
    .process-card {
      flex-direction: row;
      align-items: center;
      gap: 4rem;
    }

    /* Reset order on desktop so row-reverse works as intended */
    .process-image-wrapper,
    .process-content {
      order: 0;
    }

    .process-card-reverse {
      flex-direction: row-reverse;
    }

    .process-content {
      flex: 1;
      text-align: left;
    }

    /* .process-card-reverse .process-content {
      text-align: right;
    } */

    .process-description {
      margin: 0;
    }

    .process-card-reverse .process-description {
      margin-left: auto;
    }

    .process-image-wrapper {
      flex: 1;
    }

    .process-card-reverse .process-badge {
      left: auto;
      right: -20px;
    }
  }

  @media (max-width: 760px) {
    .process-badge {
      left: 50%;
      transform: translateX(-50%);
    }

    .process-card {
      margin-inline: auto;
      padding-inline: 0;
    }

    .process-content {
      text-align: left;
    }
  }
</style>
