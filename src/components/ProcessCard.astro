---
export interface Props {
  image: string;
  title: string;
  description: string;
  className?: string;
}

const { image, title, description, className = "" } = Astro.props;

---

<article
  class={`flex flex-col md:flex-row items-center justify-between py-8 border-b border-gray-800 animate-on-scroll ${className}`}
  style="transition-delay: 100ms;"
>
  <div class="md:w-5/12 md:text-left mb-6 md:mb-0">
    <div class="text-5xl font-extrabold mb-4" style="color: #D946EF;">1</div>
    <h3 class="text-3xl font-bold text-white mb-3">{title}</h3>
    <p class="text-gray-400">
      {description}
    </p>
  </div>
  <div class="md:w-6/12 flex justify-center">
   <img src={image} alt={title} class="w-full max-w-md h-56 rounded-xl shadow-2xl object-cover" loading="lazy" />
  </div>
</article>
