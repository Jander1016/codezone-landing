---
import type { ProcessCardProps } from '../types/components';

interface Props extends ProcessCardProps {}

const { 
  number, 
  title, 
  description, 
  image, 
  isEven = false 
} = Astro.props;
---

<article class:list={['process-card', { 'process-card-reverse': isEven }]}>
  <div class="process-content">
    <h3 class="text-2xl text-cyan-300 font-medium">
      {title}
    </h3>
    <p class="process-description">
      {description}
    </p>
  </div>
  
  <div class="process-image-wrapper">
    <div class="process-badge linear-gradient-primary text-3xl text-cyan-300">
      {number}
    </div>
    <img 
      src={image} 
      alt={title} 
      class="process-image" 
      loading="lazy"
      width="400"
      height="300"
    />
  </div>
</article>

<style>
  .process-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 600ms ease-out, transform 600ms ease-out;
  }

  .process-card.fade-in-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .process-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .process-badge {
    position: absolute;
    top: -20px;
    left: -40px;
    width: 64px;
    height: 46px;
    border-radius: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 700;
    z-index: 10;
  }

 
  .process-image-wrapper {
    width: 100%;
    max-width: 500px;
    position: relative;
  }

  .process-image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 6;
    border-radius: 32px;
    object-fit: cover;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }

  .process-image-wrapper:hover .process-image {
    transform: scale(1.05);
    transition: transform 300ms ease-in-out;
  }

   .linear-gradient-primary {
    background-image: linear-gradient(180deg, rgba(2, 6, 24, 1) 0%, rgba(18, 29, 70, 1) 50%),
      linear-gradient(45deg, var(--fuchsia-600), var(--cyan-300));
    background-clip: padding-box, border-box;
    background-origin: border-box;
    border: 2px solid transparent;
  }

  /* Desktop alternating layout */
  @media (min-width: 768px) {
    .process-card {
      flex-direction: row;
      align-items: center;
      gap: 4rem;
    }

    .process-card-reverse {
      flex-direction: row-reverse;
    }

    .process-content {
      flex: 1;
      text-align: left;
    }

    .process-card-reverse .process-content {
      text-align: right;
    }

    .process-description {
      margin: 0;
    }

    .process-card-reverse .process-description {
      margin-left: auto;
    }

    .process-image-wrapper {
      flex: 1;
    }

    .process-card-reverse .process-badge {
      left: auto;
      right: -20px;
    }
  }
</style>
