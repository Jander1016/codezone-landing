---
interface Props {
  variant?: "outline" | "solid";
  size?: "small" | "medium" | "large";
  // Optional href: if present renders an anchor, otherwise renders a button
  href?: string;
  // button type when rendered as <button>
  type?: "button" | "submit" | "reset";
  icon?: string;
  className?: string;
}

const { variant = "solid", size = "medium", href, type = "button", icon, className } = Astro.props;

const sizes = {
  small: "px-4 py-2 text-sm",
  medium: "px-6 py-3 text-base",
  large: "px-8 py-4 text-lg",
};
---

{href ? (
  <a href={href} class:list={["btn", `btn-${variant}`, sizes[size], className]}>
    <slot />
    {icon && <img src={`./${icon}`} alt="icon" class="ml-2" loading="lazy" />}
    <slot name="icon" />
  </a>
) : (
  <button type={type} class:list={["btn", `btn-${variant}`, sizes[size], className]}>
    <slot />
    {icon && <img src={`./${icon}`} alt="icon" class="ml-2" loading="lazy" />}
    <slot name="icon" />
  </button>
)}

<style>
  .btn {
    width: auto;
    height: 38px;
    display: inline-flex;
    padding: 12px 16px;
    gap: 8px;
    justify-content: center;
    align-items: center;
    text-decoration: none;
    font-weight: 500;
    color: #fcfcfc;
    border-radius: 100px;
    white-space: nowrap;
    cursor: pointer;
  }

/* background: var(--cz-default-gradient, linear-gradient(90deg, #C800DE 0%, #53EAFD 100%)); */
  .btn-outline {
    background: transparent;
    background-image: linear-gradient(
        180deg,
        rgba(18, 29, 70, 1) 0%,
        rgba(18, 29, 70, 1) 50%
      ),
      linear-gradient(90deg, #C800DE 0%, #53EAFD 100%);
    background-clip: padding-box, border-box;
    background-origin: border-box;
    background-position: center left;
    background-size: 200% 200%;
    border: 2px solid transparent;
    transition: all 600ms ease;
  }

  .btn-outline:hover {
    background-position: center right;
    color: #b100ff;
  }

  .btn-solid {
    background-image: linear-gradient(
      90deg,
      #c800de 10%,
      #53eafd 50%,
      #c800de 90%
    );
    background-position: center left;
    background-size: 200% 200%;
    transition: all 600ms ease;
  }

  .btn-solid:hover {
    background-position: center right;
  }
</style>
