---
const idSeparator = Astro.props.id || "separator";
---
  <div
    id={idSeparator}
    class="w-full  pb-0 pt-20 relative flex justify-center items-end pointer-events-none select-none"
  >
    <img
      src="/separador-desktop.svg"
      alt="Separador decorativo"
      class="max-w-[1528px] w-full object-cover object-bottom"
      loading="lazy"
    />
  </div>