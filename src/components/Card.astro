---
import Point from "./point.astro";
import SpeedGauge from "./SpeedGauge.astro";

interface Props {
    title?: string;
    points?: string[];
    image?: string;
    velocitySpeed?: boolean;
}

const { title, points, image, velocitySpeed } = Astro.props;
---

<div
    class={`h-full rounded-3xl border border-cyan-300/20 flex flex-col justify-center items-start gap-4 shadow-2xl 
    ${velocitySpeed ? "p-0 border-0" : "p-8"}
    ${image ? "bg-cover bg-center" : ""}`}
    style={image ? { backgroundImage: `url(${image})` } : undefined}
>
    {
        title && (
            <h3 class="text-cyan-300 font-bold text-2xl lg:text-3xl mb-0">{title}</h3>
        )
    }
    {
        points && (
            <div class="flex justify-start items-center gap-2.5">
                <div class="flex flex-col gap-2.5">
                    {points.map((point, index) => (
                        <Point key={`${index}-${point}`} description={point} />
                    ))}
                </div>
            </div>
        )
    }
    {velocitySpeed && <SpeedGauge />}
</div>
