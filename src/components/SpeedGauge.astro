---
import { Image } from "astro:assets";
import gaugeImg from "../assets/images/velocimetro.png";
import needleImg from "../assets/images/aguja.webp";
import tooltipIconImg from "../assets/images/button-tooltip.png";

interface Props {
  maxSpeed?: number;
  label?: string;
  title?: string;
  tooltipText?: string;
  tooltipIcon?: ImageMetadata;
  gaugeImage?: ImageMetadata;
  needleImage?: ImageMetadata;
  animationDuration?: number;
}

const {
  maxSpeed = 95,
  label = "PSI",
  title = "Alto rendimiento y velocidad",
  tooltipText = "Una puntuación alta en Google's PageSpeed Insights no es solo un número; es una mejor experiencia de usuario y un mejor posicionamiento. Desarrollamos para la velocidad.",
  tooltipIcon = tooltipIconImg,
  gaugeImage = gaugeImg,
  needleImage = needleImg,
  animationDuration = 2,
} = Astro.props;
---

<div
  class="gauge-section"
  data-max-speed={maxSpeed}
  data-animation-duration={animationDuration}
>
  <div class="box-to-scale rounded-3xl md:rounded-4xl overflow-hidden">
    <div class="contenedor-velocimetro">
      <div class="info-velocimetro">
        <h4>{title}</h4>
        <div class="box-tooltip">
          <Image src={tooltipIcon} alt="Info" />
        </div>
      </div>

      <div class="tooltip">
        <p class="paragraph-tooltip">
          <span>Velocidad, UX y SEO</span>
          <span>{tooltipText}</span>
        </p>
      </div>

      <div class="contador-numero">
        <span class="counter-label">{label}</span>
        <span class="speed-number">0</span>+
      </div>

      <div class="velocimetro">
        <Image src={gaugeImage} alt="" aria-hidden="true" loading="eager" />
      </div>

      <div class="aguja">
        <Image src={needleImage} alt="" aria-hidden="true" loading="eager" />
      </div>
    </div>
  </div>
</div>

<style>
  .gauge-section {
    width: 100%;
    height: 100%;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    background-color: var(--primary-blue);
    color: var(--light-gray);
    border-radius: 24px;
  }

  .box-to-scale {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 480 / 332;
    overflow: hidden;
    border: 2px solid #53eafd26;
  }

  .contenedor-velocimetro {
    width: 100%;
    height: 100%;
    position: relative;
    background: radial-gradient(
      at -50% -75%,
      rgba(83, 234, 253, 1) 0%,
      rgba(0, 7, 22, 1) 50%
    );
    background-repeat: no-repeat;
    background-size: cover;
    padding: 6% 4%;
    box-sizing: border-box;
  }

  .aguja {
    position: absolute;
    bottom: 15.6%;
    left: 50%;
    width: 6.66%;
    height: auto;
    aspect-ratio: 32 / 165;
    transform-origin: 50% 90.9%;
    transform: translateX(-50%) rotate(-90deg);
    border-radius: 4px;
    z-index: 10;
  }

  .aguja img {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0.5cqi 0px 0.6cqi #000000);
  }

  .velocimetro {
    position: absolute;
    bottom: 3%;
    left: 50%;
    transform: translateX(-50%);
    width: 87.7%;
    height: auto;
    aspect-ratio: 421 / 223;
  }

  .velocimetro img {
    width: 100%;
    height: 100%;
  }

  .contador-numero {
    position: absolute;
    top: 16.5%;
    left: 4.2%;
    font-size: 8.3cqi;
    font-weight: bold;
    color: var(--fuchsia-600);
    z-index: 20;
  }

  .counter-label {
    color: var(--cyan-300);
    font-size: 4.16cqi;
    font-weight: normal;
    margin-bottom: 0.2em;
  }

  .info-velocimetro {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    margin: auto;
  }

  .info-velocimetro h4 {
    font-size: 4.16cqi;
    font-weight: 500;
    color: var(--cyan-300);
    margin: 0;
  }

  .box-tooltip {
    height: 6.6cqi;
    width: 6.6cqi;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 40;
  }

  .box-tooltip img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tooltip {
    position: absolute;
    top: 60%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 340px;
    max-width: 340px;
    white-space: normal;
    min-height: 50px;
    opacity: 0;
    visibility: hidden;
    background-color: var(--primary-blue);
    color: var(--light-gray);
    padding: 16px;
    border-radius: 8px;
    border: 2px solid var(--fuchsia-600);
    pointer-events: none;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
    font-size: var(--font-size-card);
    z-index: 100;
    /* transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      visibility 0.3s;
    backdrop-filter: blur(4px); */
    /* text-wrap: balance; */
  }

  .tooltip.active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%);
    pointer-events: auto;
    font-size: var(--font-size-card);
  }

  .tooltip span:first-child {
    font-weight: 700;
    color: var(--cyan-300);
    display: block;
  }

  .tooltip span:last-child {
    font-weight: 100;
  }

  .paragraph-tooltip {
    font-size: var(--font-size-card);
  }

  @media (min-width: 960px) {
    .tooltip {
      position: absolute;
      top: 0;
      left: 0;
      width: 340px !important;
      padding: 16px !important;
      transform: scale(0.8);
    }

    .tooltip.active {
      transform: scale(1);
    }
  }
</style>
