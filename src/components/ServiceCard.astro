---
export interface Props {
  title: string;
  description: string;
  image: string;
  cta?: string;
  ctaHref?: string;
  className?: string;
}
import Button from "./Button.astro";
const {
  title,
  description,
  image,
  cta = "Más info",
  ctaHref = "#",
  className = "",
} = Astro.props;

// Quick build-time optimization: add @2x to srcset only if file exists in public/
import fs from "fs";
import path from "path";
const publicPath = path.resolve(
  Astro.site ? new URL(Astro.site).pathname : "./public",
);
// The `image` prop is like '/imagen.webp' — build the filesystem path
const imagePath = path.join(
  process.cwd(),
  "public",
  image.replace(/^[\/]/, ""),
);
const image2xPath = imagePath.replace(".webp", "@2x.webp");
const has2x = fs.existsSync(image2xPath);
const srcsetValue = has2x
  ? `${image} 1x, ${image.replace(".webp", "@2x.webp")} 2x`
  : undefined;
---

<div class={`card-layout outer-glow-fx ${className}`}>
  <div class="card-image">
    <img
      src={image}
      alt={title}
      loading="lazy"
      decoding="async"
      width="1200"
      height="600"
      class="w-full h-full object-cover"
      srcset={srcsetValue}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
    />
  </div>
  <div class="card-text">
    <h3 class="text-cyan-300 font-bold text-2xl mb-0">{title}</h3>
    <p class="text-neutral-100 m-0">{description}</p>
  </div>
  <Button href={ctaHref} variant="outline" size="medium">
    {cta}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="#38AEBD"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="ml-2"
      ><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg
    >
  </Button>
</div>

<style>
  .card-layout {
    margin: 0 auto;
    max-width: 380px;
    background: rgba(2, 6, 24, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(83, 233, 253, 0.15);
    display: inline-flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 20px;
    border-radius: 24px;
    padding: 8px;
    text-align: left;
  }

  .card-text {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    gap: 12px;
  }

  .card-text h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .card-text p {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    border-radius: 20px;
    display: block;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: all 600ms ease-in-out;
  }

  .card-layout:hover .card-image img {
    transform: scale(1.05);
  }

  /* EFECTO HOVER EN CARD - PRESERVED */
  .outer-glow-fx {
    -webkit-box-shadow: 0px 0px 0px 0px rgba(83, 233, 253, 0.75);
    -moz-box-shadow: 0px 0px 0px 0px rgba(83, 233, 253, 0.75);
    box-shadow: 0px 0px 0px 0px rgba(83, 233, 253, 0.75);
    transition: all 600ms ease-in-out;
  }

  .outer-glow-fx:hover {
    -webkit-box-shadow: 0px 0px 20px 0px rgba(83, 233, 253, 0.6);
    -moz-box-shadow: 0px 0px 20px 0px rgba(83, 233, 253, 0.6);
    box-shadow: 0px 0px 20px 0px rgba(83, 233, 253, 0.6);
    border-color: rgba(83, 233, 253, 0.3);
  }

  /* Responsive Design */
  @media (min-width: 768px) {
    .card-layout {
      flex-direction: column;
      max-width: 360px;
    }
    .card-image {
      height: 200px;
    }
  }

  @media (min-width: 1024px) {
    .card-layout {
      max-width: 380px;
    }
  }
</style>
