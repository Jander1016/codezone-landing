---
export interface Props {
  title: string;
  description: string;
  image: string;
  cta?: string;
  ctaHref?: string;
}
import Button from "./Button.astro";
const {
  title,
  description,
  image,
  cta = "Más info",
  ctaHref = "#",
} = Astro.props;
---

<div class="card-layout outer-glow-fx">
  <div class="card-image">
    <img
      src={image}
      alt={title}
      loading="lazy"
      class="w-full h-full object-cover"
    />
  </div>
  <div class="card-text">
    <h3 class="text-cyan-300 font-bold text-2xl mb-0">{title}</h3>
    <p class="text-neutral-100 m-0">{description}</p>
  </div>
  <Button href={ctaHref} variant="outline" size="medium">
    {cta}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="#38AEBD"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="ml-2"
      ><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg
    >
  </Button>
</div>

<style>
  .card-layout {
    margin: 0 auto;
    max-width: 480px;
    background-image: linear-gradient(
      180deg,
      rgba(2, 6, 24, 1) 25%,
      rgba(14, 50, 97, 0.3) 50%
    );
    display: inline-flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 16px;
    border-radius: 32px;
    padding: 4px 4px 8px 4px;
    text-align: left;
  }

  .card-text {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding: 8px;
    gap: 16px;
  }

  .card-image {
  width: 100%;
  height: 190px;
  overflow: hidden;
  border-radius: 28px;
  display: block;
  }

  .card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: all 600ms ease-in-out;
  }

  .card-layout:hover .card-image img {
    transform: scale(1.05);
  }
  /* EFECTO HOVER EN CARD */

  .outer-glow-fx {
    -webkit-box-shadow: 0px 0px 0px 0px rgba(83, 233, 253, 0.75);
    -moz-box-shadow: 0px 0px 0px 0px rgba(83, 233, 253, 0.75);
    box-shadow: 0px 0px 0px 0px rgba(83, 233, 253, 0.75);
    transition: all 600ms ease-in-out;
  }

  .outer-glow-fx:hover {
    -webkit-box-shadow: 0px 0px 15px 0px rgba(83, 233, 253, 0.75);
    -moz-box-shadow: 0px 0px 15px 0px rgba(83, 233, 253, 0.75);
    box-shadow: 0px 0px 15px 0px rgba(83, 233, 253, 0.75);
  }

  /* Responsive Design */
  @media (min-width: 768px) {
    .card-layout {
      flex-direction: column;
      max-width: 400px;
    }
    .card-image {
      height: 220px;
    }
  }
</style>
