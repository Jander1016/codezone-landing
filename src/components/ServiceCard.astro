---
export interface Props {
  title: string;
  description: string;
  image: string;
  cta?: string;
  ctaHref?: string;
  className?: string;
}
import Button from "./Button.astro";
const {
  title,
  description,
  image,
  cta = "Más info",
  ctaHref = "#",
  className = "",
} = Astro.props;

const srcsetValue = `
  ${image} 600w,
  ${image} 900w,
  ${image} 1200w
`;
---

<div class={`card-layout outer-glow-fx ${className}`}>
  <div class="card-image">
    <img
      src={image}
      alt={`Imagen representativa de ${title}`}
      width="480"
      height="220"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover"
    />
  </div>
  <div class="card-text">
    <h3 class="text-cyan-300 font-bold text-2xl md:text-3xl lg:text-[32px] mb-0">{title}</h3>
    <p class="m-0">{description}</p>
  </div>
  <Button href={ctaHref} variant="outline" size="medium" icon="icon-arrow.svg">
    {cta}
  </Button>
</div>

<style>
  .card-layout.outer-glow-fx {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin: 0 auto;
    width: 100%;
    height: 100%; 
    flex-wrap: nowrap;
    gap: 16px;
    border-radius: 24px;
    padding: 8px;
    background-image: linear-gradient(
      180deg,
      #0e1738 0.38%,
      rgba(18, 29, 70, 0) 100%
    );
    border: 2px solid #53eafd26;
  }

  .card-text {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    gap: 12px;
  }

  .card-text h3 {
    /* font-size: 1.5rem; */
    margin-bottom: 0.5rem;
  }

  .card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    border-radius: 20px;
    display: block;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: all 600ms ease-in-out;
  }

  .card-layout:hover .card-image img {
    transform: scale(1.15);
  }

  /* EFECTO HOVER EN CARD - PRESERVED */
  .outer-glow-fx {
    /* -webkit-box-shadow: 0px 0px 0px 0px rgba(83, 233, 253, 0.75);
    -moz-box-shadow: 0px 0px 0px 0px rgba(83, 233, 253, 0.75); */
    box-shadow: 0px 0px 0px 0px #02061866;
    transition: all 600ms ease-in-out;
  }

  .outer-glow-fx:hover {
    /* -webkit-box-shadow: 0px 0px 20px 0px rgba(83, 233, 253, 0.6);
    -moz-box-shadow: 0px 0px 20px 0px rgba(83, 233, 253, 0.6);*/
    /* box-shadow: 0px 0px 20px 0px rgba(83, 233, 253, 0.6);  */
    box-shadow: 0px 15px 25px 0px #02061866;
    border-color: rgba(83, 233, 253, 0.3);
    transition: all 300ms ease-in-out;
  }

  /* Responsive Design */
  @media (min-width: 768px) {
    .card-layout {
      flex-direction: column;
      width: 100%;
      height: 100%;
    }
    .card-image {
      height: 200px;
    }
  }

  @media (min-width: 1024px) {
    .card-layout {
      width: 100%;
    }
  }
</style>
