---
// SVG separador curvo para la sección Hero
---
<div class="hero-separator-wrapper">
  <svg class="hero-separator-svg" viewBox="0 0 1440 180" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%" height="180" preserveAspectRatio="none">
    <path d="M0 120 Q 720 220 1440 120" stroke="url(#gradient)" stroke-width="3" fill="none"/>
    <defs>
      <linearGradient id="gradient" x1="0" y1="0" x2="1440" y2="0" gradientUnits="userSpaceOnUse">
        <stop stop-color="#53EAFD" stop-opacity="0.7"/>
        <stop offset="0.5" stop-color="#D946EF" stop-opacity="0.7"/>
        <stop offset="1" stop-color="#53EAFD" stop-opacity="0.7"/>
      </linearGradient>
    </defs>
  </svg>
</div>

<style>
.hero-separator-wrapper {
  width: 100vw;
  overflow: hidden;
  position: relative;
  z-index: 2;
  margin-bottom: -60px;
}
.hero-separator-svg {
  display: block;
  width: 100vw;
  height: 180px;
}
</style>
