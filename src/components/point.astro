---
interface Props {
    description: string;
    key?: string;
}

const { description } = Astro.props;
---


<div class="flex flex-row items-baseline gap-3.5">
    <div
        class="size-1 bg-cyan-300 rounded-full shadow-[0px_0px_8px_3px_rgba(83,234,253,0.75)] flex items-center justify-center"
    >
        <span class="text-xs font-medium">•</span>
    </div>
    <p class="font-medium leading-10">
        {description}
    </p>
</div>
