---
interface Props {
    description: string;
    key?: string;
}

const { description } = Astro.props;
---


<div class="flex flex-row items-center gap-3.5">
    <div
        class="w-1 h-1 bg-cyan-300 rounded-full shadow-[0px_0px_8px_3px_rgba(83,234,253,0.75)]"
    >
    </div>
    <div class="text-neutral-100 text-[15px] md:text-lg">
        {description}
    </div>
</div>
