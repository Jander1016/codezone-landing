---
import type { NavItem } from "../types/components";
import Button from "./Button.astro";

interface Props {
  navItems: NavItem[];
  logoSrc?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  navItems,
  logoSrc = "/codezone-logo-color.svg",
} = Astro.props as Props;
---

<button
  id="mobilemenu-burger"
  class="mobilemenu-burger"
  aria-label="Abrir menú"
  aria-expanded="false"
  type="button"
>
  <div
    id="mobilemenu-burger-icon"
    class="mobilemenu-burger-icon"
    aria-hidden="true"
  >
    <span class="line"></span>
    <span class="line"></span>
    <span class="line"></span>
  </div>
</button>

<div id="mobilemenu-overlay" class="mobilemenu-overlay" aria-hidden="true">
  <div class="overlay-top">
    <a class="overlay-brand" href="#hero">
      <img src={logoSrc} alt="Codezone" width="180" height="26" />
    </a>
  </div>

  <div id="mobilemenu-items" class="mobilemenu-items">
    <ul class="mobilemenu-list">
      {
        navItems.map((item, i) => (
          <li>
            <a
              href={item.href}
              class="mobilemenu-item"
              data-index={i}
              aria-current={item.isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="py-8">
      <Button
        href="#contact-separator"
        variant="outline"
        size="small"
        icon="icon-arrow.svg"
        className="mobilemenu-cta"
      >
        Contacto
      </Button>
    </div>
  </div>
</div>

<!-- serialize nav items so client script can use the authoritative data source -->
<script type="application/json" id="mobilemenu-data">{JSON.stringify(navItems)}</script>

<script>
  /* @ts-nocheck */
  document.addEventListener("DOMContentLoaded", () => {
    const burgerBtn = document.getElementById("mobilemenu-burger");
    const burgerIcon = document.getElementById("mobilemenu-burger-icon");
    const overlay = document.getElementById("mobilemenu-overlay");
    // only select the mobile menu items and the CTA inside the menu
    const menuItems = document.querySelectorAll('.mobilemenu-item, .mobilemenu-cta');

  let isMenuOpen = false;
  // increase overlay duration for a smoother open/close and keep it in sync with CSS
  const overlayTransitionDuration = 700; // ms - should match CSS
  // slightly larger stagger for a softer feel
  const itemAnimationDuration = 110;

    function animateMenuItems(isOpening: boolean) {
      const elements = Array.from(menuItems);
      if (!isOpening) elements.reverse();

      elements.forEach((item, index) => {
        const delay = index * itemAnimationDuration;
        setTimeout(() => {
          const el = item as HTMLElement;
          if (isOpening) {
            el.style.transform = "translateY(0px)";
            el.style.opacity = "1";
          } else {
            el.style.transform = "translateY(10px)";
            el.style.opacity = "0";
          }
        }, delay);
      });
    }

    function toggleMenu() {
      isMenuOpen = !isMenuOpen;
      if (burgerIcon) burgerIcon.classList.toggle("active", isMenuOpen);
      if (burgerBtn)
        burgerBtn.setAttribute("aria-expanded", String(isMenuOpen));

      if (isMenuOpen) {
        if (overlay) {
          overlay.classList.add("visible");
          overlay.setAttribute('aria-hidden', 'false');
          overlay.setAttribute('role', 'dialog');
          overlay.setAttribute('aria-modal', 'true');
          try { (overlay as any).inert = false; } catch (e) { /* ignore if not supported */ }
        }
        document.body.style.overflow = "hidden";
        setTimeout(() => {
          animateMenuItems(true);
          // focus first menu item for keyboard users
          const first = document.querySelector('.mobilemenu-item, .mobilemenu-cta') as HTMLElement | null;
          if (first) first.focus();
        }, overlayTransitionDuration);
      } else {
        animateMenuItems(false);
        const totalItemDuration = menuItems.length * itemAnimationDuration;
        setTimeout(() => {
          if (overlay) {
            overlay.classList.remove("visible");
            overlay.setAttribute('aria-hidden', 'true');
            try { (overlay as any).inert = true; } catch (e) { /* ignore */ }
            overlay.removeAttribute('role');
            overlay.removeAttribute('aria-modal');
          }
          document.body.style.overflow = "";
          // if focus remained inside the overlay, move it back to the burger button
          try {
            const active = document.activeElement as Element | null;
            if (active && overlay && overlay.contains(active)) {
              if (burgerBtn) {
                (burgerBtn as HTMLElement).focus();
              } else {
                (document.body as HTMLElement).focus();
              }
            }
          } catch (e) { /* ignore focus handling errors */ }
        }, totalItemDuration + 100);
      }
    }

    if (burgerBtn) burgerBtn.addEventListener("click", toggleMenu);

    // parse nav data serialized server-side so we use the canonical source
    const navDataEl = document.getElementById('mobilemenu-data');
    let navData = [];
    try {
      if (navDataEl && navDataEl.textContent) navData = JSON.parse(navDataEl.textContent);
    } catch (err) {
      navData = [];
    }

    function setActiveByHref(href: string | null) {
      const scope = Array.from(document.querySelectorAll('a.nav-link, #mobilemenu-items a'));
      scope.forEach(a => a.removeAttribute('aria-current'));
      if (!href) return;
      const matches = Array.from(document.querySelectorAll(`a.nav-link[href="${href}"], #mobilemenu-items a[href="${href}"]`));
      matches.forEach(m => m.setAttribute('aria-current', 'page'));
    }

    // When a menu item is clicked: smooth-scroll to target, set active link, then close menu
    menuItems.forEach((item) => {
      item.addEventListener("click", (ev) => {
        const el = ev.currentTarget;
        if (!(el instanceof Element)) return;
        // Prefer the canonical nav data via data-index when available
        const idx = el.getAttribute('data-index');
        let href = (el.getAttribute && el.getAttribute('href')) || '';
        if (idx !== null && navData[idx]) {
          href = navData[idx].href || href;
        }

        if (href && href.startsWith('#')) {
          ev.preventDefault();
          // contact clears active state
          // set active link in header (uses canonical nav data)
          try {
            // Dispatch custom event so header can react and set active nav (null clears it)
            const detail = href === '#contact-separator' ? null : href;
            window.dispatchEvent(new CustomEvent('codezone:setActiveNavHref', { detail }));
          } catch (err) {
            /* ignore */
          }

          const target = document.getElementById(href.slice(1));

          if (isMenuOpen) {
            // close with animation, then scroll once overlay is hidden
            toggleMenu();
            const totalItemDuration = menuItems.length * itemAnimationDuration;
            setTimeout(() => {
              if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, totalItemDuration + 120);
          } else {
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        } else {
          // non-anchor or external link: just close menu (navigation will follow naturally)
          if (isMenuOpen) toggleMenu();
        }
      });
    });

    // When clicking the overlay brand (logo) inside the mobile menu, close the menu,
    // scroll to hero and clear active nav (remove cyan) so behavior matches desktop.
    const overlayBrand = document.querySelector('.overlay-brand[href="#hero"]');
    if (overlayBrand) {
      overlayBrand.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById('hero');
        if (isMenuOpen) toggleMenu();
        const delay = isMenuOpen ? (menuItems.length * itemAnimationDuration + 120) : 0;
        setTimeout(() => {
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          try {
            window.dispatchEvent(new CustomEvent('codezone:setActiveNavHref', { detail: null }));
          } catch (err) {
            /* ignore */
          }
          try {
            history.replaceState(null, '', window.location.pathname + window.location.search);
          } catch (err) {
            /* ignore */
          }
        }, delay);
      });
    }
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isMenuOpen) toggleMenu();
    });
  });
</script>

<style>
  /* Keep the burger fixed in the viewport so it doesn't disappear when the page scrolls or sections change */
  .mobilemenu-burger {
    position: fixed;
    right: 12px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    z-index: 9999;
  }

  .mobilemenu-burger-icon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: end;
    width: 24px;
    height: 18px;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobilemenu-burger-icon .line {
    height: 2px;
    background: currentColor;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .line:nth-child(1) {
    width: 100%;
  }

  .line:nth-child(2) {
    width: 80%;
  }

  .line:nth-child(3) {
    width: 60%;
  }

  .mobilemenu-burger-icon.active {
    width: 80%;
  }

  .mobilemenu-burger-icon.active .line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
    width: 80%;
  }
  .mobilemenu-burger-icon.active .line:nth-child(2) {
    opacity: 0;
    width: 80%;
  }
  .mobilemenu-burger-icon.active .line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
    width: 80%;
  }

  .mobilemenu-overlay {
    position: fixed;
    inset: 0;
    height: 100vh;
    width: 100vw;
    z-index: 9998;
    transform: scaleY(0);
    transform-origin: top;
  /* smoother curve and longer duration to feel less abrupt */
  transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    background: var(--primary-blue);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    top: -20px;
    left: -10px;
    right: 0;
    bottom: 0;
  }
  .mobilemenu-overlay.visible {
    transform: scaleY(1);
  }

  .overlay-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    position: absolute;
    top: 25px;
    left: 0;
    width: 100%;
    z-index: 66;
  }
  .overlay-brand img {
    display: block;
    width: 140px;
    height: auto;
  }
  .overlay-close {
    background: transparent;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .mobilemenu-items {
    margin-top: 6.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem;
  }
  .mobilemenu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }
  .mobilemenu-item {
    color: #fcfcfc;
    font-size: 1.25rem;
    text-decoration: none;
    opacity: 0;
    transform: translateY(10px);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  
  .mobilemenu-item[aria-current="page"] {
    color: var(--cyan-300, #53eafd);
    font-weight: 600;
  }
  .mobilemenu-cta {
    margin-top: 1.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    color: var(--cyan-300, #53eafd);
    background: transparent;
    border: 2px solid var(--fuchsia-600, #c800de);
    text-decoration: none;
    opacity: 0;
    transform: translateY(10px);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .item-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }

  @media (min-width: 1024px) {
    .mobilemenu-burger,
    .mobilemenu-overlay {
      display: none;
    }
  }
</style>
