---
/**
 * MobileMenu Component
 * 
 * Full-screen mobile navigation menu with:
 * - Hamburger toggle button
 * - Overlay with backdrop blur
 * - Slide-in animation
 * - Accessibility features (ARIA, keyboard navigation)
 * - Auto-close on link click and ESC key
 */

import type { NavItem } from '../data/navigation';
import Button from './Button.astro';

interface Props {
  navItems: NavItem[];
  logoSrc?: string;
}

const { 
  navItems,
  logoSrc = "/codezone-logo-color.svg"
} = Astro.props;
---

<button
  id="mobilemenu-burger"
  class="mobilemenu-burger"
  aria-label="Abrir menú"
  aria-expanded="false"
  aria-controls="mobilemenu-overlay"
  type="button"
>
  <div
    id="mobilemenu-burger-icon"
    class="mobilemenu-burger-icon"
    aria-hidden="true"
  >
    <span class="line"></span>
    <span class="line"></span>
    <span class="line"></span>
  </div>
</button>

<div 
  id="mobilemenu-overlay" 
  class="mobilemenu-overlay" 
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación móvil"
>
  <!-- Logo CodeZone - Fixed position top left -->
  <div class="mobilemenu-header">
    <a class="mobilemenu-logo" href="#hero">
      <img src={logoSrc} alt="Codezone" width="140" height="26" />
    </a>
  </div>

  <!-- Menu items centered -->
  <div id="mobilemenu-items" class="mobilemenu-items">
    <!-- Navigation Links -->
    <ul class="mobilemenu-list">
      {navItems.map((item, i) => (
        <li>
          <a
            href={item.href}
            class="mobilemenu-item"
            data-nav-link
            data-index={i}
            data-section={item.href.startsWith('#') ? item.href.slice(1) : item.href}
            aria-current={item.isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Contact CTA -->
    <div class="mobilemenu-cta-wrapper">
      <Button
        href="#mobile-contact-separator"
        variant="outline"
        size="small"
        icon="icon-arrow.svg"
        className="mobilemenu-cta"
      >
        Contacto
      </Button>
    </div>
  </div>
</div>

<!-- serialize nav items so client script can use the authoritative data source -->
<script type="application/json" id="mobilemenu-data">
  {JSON.stringify(navItems)}
</script>

<script>
  /* @ts-nocheck */
  import { 
    handleMobileNavigation,
    NAV_CONFIG 
  } from '../utils/navigation/navigation-manager';

  document.addEventListener("DOMContentLoaded", () => {
    const burgerBtn = document.getElementById("mobilemenu-burger");
    const burgerIcon = document.getElementById("mobilemenu-burger-icon");
    const overlay = document.getElementById("mobilemenu-overlay");
    const logo = document.querySelector('.mobilemenu-logo');
    
    // Select animated items: menu items and CTA (logo stays fixed, no animation)
    const menuItems = document.querySelectorAll('.mobilemenu-item, .mobilemenu-cta');
    const allAnimatedItems = Array.from(menuItems);
    
    let isMenuOpen = false;

    // Overlay and animation timing
    const overlayTransitionDuration = 700; // ms - should match CSS
    const itemAnimationDuration = 110;

    /**
     * Anima los items del menú con efecto escalonado.
     * Aplica transformaciones y opacidad a cada item con un delay incremental
     * para crear un efecto de cascada visual.
     * 
     * @param {boolean} isOpening - true si el menú se está abriendo, false si se está cerrando
     * @returns {void}
     */
    function animateMenuItems(isOpening: boolean): void {
      const elements = Array.from(allAnimatedItems);
      if (!isOpening) elements.reverse();
      
      elements.forEach((item, index) => {
        const delay = index * itemAnimationDuration;
        setTimeout(() => {
          const el = item as HTMLElement;
          if (isOpening) {
            el.style.transform = "translateY(0px)";
            el.style.opacity = "1";
          } else {
            el.style.transform = "translateY(10px)";
            el.style.opacity = "0";
          }
        }, delay);
      });
    }



    /**
     * Alterna el estado abierto/cerrado del menú móvil.
     * Maneja animaciones, actualiza atributos ARIA, gestiona el overflow del body,
     * y maneja el foco del teclado para accesibilidad.
     * 
     * @returns {void}
     */
    function toggleMenu(): void {
      isMenuOpen = !isMenuOpen;
      
      if (burgerIcon) burgerIcon.classList.toggle("active", isMenuOpen);
      if (burgerBtn) burgerBtn.setAttribute("aria-expanded", String(isMenuOpen));
      
      if (isMenuOpen) {
        // Calculate scrollbar width before hiding overflow
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        
        if (overlay) {
          overlay.classList.add("visible");
          overlay.setAttribute('aria-hidden', 'false');
          try { (overlay as any).inert = false; } catch (e) { /* ignore if not supported */ }
        }
        
        // Prevent body scroll and compensate for scrollbar
        document.body.style.overflow = "hidden";
        document.body.style.paddingRight = `${scrollbarWidth}px`;
        
        setTimeout(() => {
          animateMenuItems(true);
          // focus first menu item for keyboard users
          const first = document.querySelector('.mobilemenu-item') as HTMLElement | null;
          if (first) first.focus();
        }, overlayTransitionDuration);
      } else {
        animateMenuItems(false);
        const totalItemDuration = allAnimatedItems.length * itemAnimationDuration;
        
        setTimeout(() => {
          if (overlay) {
            overlay.classList.remove("visible");
            overlay.setAttribute('aria-hidden', 'true');
            try { (overlay as any).inert = true; } catch (e) { /* ignore */ }
          }
          
          // Restore body scroll and remove padding
          document.body.style.overflow = "";
          document.body.style.paddingRight = "";
          
          // Return focus to burger button
          try {
            const active = document.activeElement as Element | null;
            if (active && overlay && overlay.contains(active)) {
              if (burgerBtn) {
                (burgerBtn as HTMLElement).focus();
              } else {
                (document.body as HTMLElement).focus();
              }
            }
          } catch (e) { /* ignore focus handling errors */ }
        }, totalItemDuration + 100);
      }
    }

    if (burgerBtn) burgerBtn.addEventListener("click", toggleMenu);

    // Parse nav data serialized server-side
    const navDataEl = document.getElementById('mobilemenu-data');
    let navData = [];
    try {
      if (navDataEl && navDataEl.textContent) navData = JSON.parse(navDataEl.textContent);
    } catch (err) {
      navData = [];
    }



    // Handle menu item clicks
    menuItems.forEach((item) => {
      item.addEventListener("click", (ev) => {
        const el = ev.currentTarget;
        if (!(el instanceof Element)) return;
        
        ev.preventDefault();
        
        const idx = el.getAttribute('data-index');
        let href = (el.getAttribute && el.getAttribute('href')) || '';
        if (idx !== null && navData[idx]) {
          href = navData[idx].href || href;
        }

        if (href && href.startsWith('#')) {
          // Calculate delay based on menu animation
          const totalItemDuration = allAnimatedItems.length * itemAnimationDuration;
          const menuCloseDelay = totalItemDuration + NAV_CONFIG.MENU_CLOSE_DELAY;
          
          // Use NavigationManager with menu close coordination
          handleMobileNavigation(
            href,
            () => {
              if (isMenuOpen) toggleMenu();
            },
            { menuCloseDelay }
          );
        } else {
          if (isMenuOpen) toggleMenu();
        }
      });
    });

    // Handle logo click
    if (logo) {
      logo.addEventListener('click', (e) => {
        e.preventDefault();
        
        // Calculate delay based on menu animation
        const totalItemDuration = allAnimatedItems.length * itemAnimationDuration;
        const menuCloseDelay = totalItemDuration + NAV_CONFIG.MENU_CLOSE_DELAY;
        
        // Use NavigationManager for logo navigation
        handleMobileNavigation(
          '#hero',
          () => {
            if (isMenuOpen) toggleMenu();
          },
          { menuCloseDelay }
        );
      });
    }

    // Listen for active nav updates from NavigationManager
    window.addEventListener('codezone:setActiveNavHref', (event) => {
      const activeHref = (event as CustomEvent).detail;
      const mobileLinks = document.querySelectorAll('.mobilemenu-item');
      
      // Update visual state of mobile menu links
      mobileLinks.forEach(link => {
        const href = link.getAttribute('href');
        
        if (href === activeHref) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    });

    // ESC key to close
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isMenuOpen) {
        e.preventDefault();
        toggleMenu();
      }
    });
    
    /**
     * Configura el focus trap para el menú móvil.
     * Asegura que el foco permanezca dentro del menú cuando está abierto,
     * creando un loop de navegación con Tab. El usuario siempre puede escapar con ESC.
     * 
     * @returns {void}
     */
    function setupFocusTrap(): void {
      if (!overlay) return;
      
      const focusableElements = overlay.querySelectorAll(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      );
      
      if (focusableElements.length === 0) return;
      
      const firstFocusable = focusableElements[0] as HTMLElement;
      const lastFocusable = focusableElements[focusableElements.length - 1] as HTMLElement;
      
      // Handle Tab key to create focus loop
      overlay.addEventListener('keydown', (e) => {
        if (!isMenuOpen) return;
        
        if (e.key === 'Tab') {
          // Shift + Tab (backwards)
          if (e.shiftKey) {
            if (document.activeElement === firstFocusable) {
              e.preventDefault();
              lastFocusable.focus();
            }
          } 
          // Tab (forwards)
          else {
            if (document.activeElement === lastFocusable) {
              e.preventDefault();
              firstFocusable.focus();
            }
          }
        }
      });
    }
    
    setupFocusTrap();
    
    /**
     * Handle Enter and Space keys on menu items for better keyboard support
     */
    menuItems.forEach((item) => {
      item.addEventListener('keydown', (e) => {
        const keyEvent = e as KeyboardEvent;
        
        // Space key should activate links (Enter already works by default)
        if (keyEvent.key === ' ' || keyEvent.key === 'Spacebar') {
          keyEvent.preventDefault();
          (item as HTMLElement).click();
        }
      });
    });
  });
</script>

<style>
  /* Hamburger button - fixed position */
  .mobilemenu-burger {
    position: fixed;
    right: 12px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    cursor: pointer;
    z-index: var(--z-mobile-burger);
    -webkit-tap-highlight-color: transparent;
  }

  .mobilemenu-burger:focus-visible {
    outline: 2px solid var(--cyan-300);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .mobilemenu-burger-icon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: end;
    width: 24px;
    height: 18px;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobilemenu-burger-icon .line {
    height: 2px;
    background: currentColor;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .line:nth-child(1) {
    width: 100%;
  }

  .line:nth-child(2) {
    width: 80%;
  }

  .line:nth-child(3) {
    width: 60%;
  }

  /* Animated hamburger when menu is open */
  .mobilemenu-burger-icon.active {
    width: 80%;
  }

  .mobilemenu-burger-icon.active .line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
    width: 80%;
  }

  .mobilemenu-burger-icon.active .line:nth-child(2) {
    opacity: 0;
    width: 80%;
  }

  .mobilemenu-burger-icon.active .line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
    width: 80%;
  }

  /* Full-screen overlay */
  .mobilemenu-overlay {
    position: fixed;
    inset: 0;
    height: 100dvh;
    width: 100dvw;
    z-index: var(--z-mobile-menu);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    background: var(--primary-blue);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    top: -20px; /* remove any top offset for better positioning */
    right: -10px;
  }

  .mobilemenu-overlay.visible {
    transform: scaleY(1);
  }

  /* Logo header - fixed position top left, same as closed state */
  .mobilemenu-header {
    position: absolute;
    top: 25px;
    left: 0;
    width: 100%;
    padding: 1rem 1.25rem;
    z-index: var(--z-base);
  }

  .mobilemenu-logo {
    display: inline-block;
    line-height: 0;
    cursor: pointer;
  }

  .mobilemenu-logo:focus-visible {
    outline: 2px solid var(--cyan-300);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .mobilemenu-logo img {
    display: block;
    width: 140px;
    height: auto;
  }

  /* Menu items container - positioned from top */
  .mobilemenu-items {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 100vh;
    padding: 1rem 1.5rem;
    gap: 1rem;
    margin-top: 0;
    padding-top: 120px;
  }

  /* Navigation list */
  .mobilemenu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  /* Menu items */
  .mobilemenu-item {
    color: #fcfcfc;
    font-size: 1.75rem;
    font-weight: 300;
    text-decoration: none;
    opacity: 0;
    transform: translateY(10px);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s ease;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    letter-spacing: 0.02em;
  }

  .mobilemenu-item:hover,
  .mobilemenu-item:focus-visible {
    color: var(--cyan-300, #53eafd);
  }

  .mobilemenu-item[aria-current="page"] {
    color: var(--cyan-300, #53eafd);
    font-weight: 600;
  }

  .mobilemenu-item:focus-visible {
    outline: 1px solid var(--cyan-300);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* CTA wrapper and button */
  .mobilemenu-cta-wrapper {
    margin-top: 2rem;
  }

  .mobilemenu-cta {
    opacity: 0;
    transform: translateY(10px);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Hide on desktop */
  @media (min-width: 1024px) {
    .mobilemenu-burger,
    .mobilemenu-overlay {
      display: none;
    }
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .mobilemenu-burger-icon,
    .mobilemenu-overlay,
    .mobilemenu-logo,
    .mobilemenu-item,
    .mobilemenu-cta {
      transition: none;
    }
  }
</style>
